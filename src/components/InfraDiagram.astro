---
/**
 * Diagrama de red de referencia con la posición de una herramienta resaltada.
 *
 * El dibujo es siempre el mismo —una infraestructura corporativa tipo, definida
 * en `src/data/infrastructure.ts`— y lo único que cambia por ficha son los nodos
 * marcados y el texto que explica por qué se sitúa ahí. Mantenerlo así permite
 * que el lector compare dos herramientas sobre el mismo mapa mental.
 */
import { nodes, edges, nodeById, VIEWBOX } from "@data/infrastructure";

interface PlacementItem {
  /** Nombre de la categoría que justifica esta posición */
  category: string;
  nodes: string[];
  rationale: string;
}

interface Props {
  items: PlacementItem[];
  /** Capas a resaltar; por defecto, las de los `items`. Permite marcar en el
   *  diagrama categorías cuya explicación se ha omitido por repetitiva. */
  highlight?: string[];
  /** Cuántas categorías comparten emplazamiento y no se explican aparte */
  omitted?: number;
}

const { items, highlight, omitted = 0 } = Astro.props;

const active = new Set(highlight?.length ? highlight : items.flatMap(i => i.nodes));

/**
 * SVG no ajusta texto solo. Se parte por palabras estimando el ancho medio de
 * carácter para cada tamaño de fuente; con dos tamaños y cajas de ancho fijo,
 * una estimación es suficiente y evita medir en cliente.
 */
function wrap(text: string, boxWidth: number, avgChar: number): string[] {
  const max = Math.max(8, Math.floor((boxWidth - 20) / avgChar));
  const out: string[] = [];
  let line = "";
  for (const word of text.split(" ")) {
    const next = line ? `${line} ${word}` : word;
    if (next.length > max && line) { out.push(line); line = word; }
    else line = next;
  }
  if (line) out.push(line);
  return out;
}

/** Geometría de una arista entre los bordes de dos cajas. */
function edgeLine(fromId: string, toId: string) {
  const a = nodeById.get(fromId)!;
  const b = nodeById.get(toId)!;
  const ac = { x: a.x + a.w / 2, y: a.y + a.h / 2 };
  const bc = { x: b.x + b.w / 2, y: b.y + b.h / 2 };
  // Columna compartida → conector vertical; en otro caso, horizontal
  if (Math.abs(ac.x - bc.x) < 4) {
    return bc.y > ac.y
      ? { x1: ac.x, y1: a.y + a.h, x2: bc.x, y2: b.y }
      : { x1: ac.x, y1: a.y, x2: bc.x, y2: b.y + b.h };
  }
  return bc.x > ac.x
    ? { x1: a.x + a.w, y1: ac.y, x2: b.x, y2: bc.y }
    : { x1: a.x, y1: ac.y, x2: b.x + b.w, y2: bc.y };
}

const drawnEdges = edges.map(e => ({
  ...e,
  ...edgeLine(e.from, e.to),
  // Una arista se ilumina solo si conecta dos nodos implicados
  on: active.has(e.from) && active.has(e.to),
}));

// Conectores punteados de las bandas transversales: gobierno baja sobre todas
// las columnas y todas las columnas suben telemetría al SOC.
const columnCenters = [101, 287, 473, 659];

const activeNodes = nodes.filter(n => active.has(n.id));
const describedBy = activeNodes.map(n => n.label).join(", ");
---

<section class="infra">
  <h2 class="section-title mb-2">Dónde encaja en la infraestructura</h2>
  <p class="infra-lead">
    Mapa de una infraestructura corporativa tipo. En azul, las capas donde opera esta herramienta.
  </p>

  <div class="infra-canvas">
    <svg viewBox={`0 0 ${VIEWBOX.w} ${VIEWBOX.h}`} role="img"
         aria-label={`Diagrama de infraestructura con las capas resaltadas: ${describedBy}`}>
      <defs>
        <marker id="infra-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0 1 L7 4 L0 7 z" fill="#c7c7cc" />
        </marker>
        <marker id="infra-arrow-on" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0 1 L7 4 L0 7 z" fill="#0071e3" />
        </marker>
      </defs>

      <!-- Bandas transversales: política hacia abajo, telemetría hacia arriba -->
      {columnCenters.map(x => (
        <>
          <line x1={x} y1="64" x2={x} y2="92" class={`tie${active.has("govern") || active.has("ops") ? " is-on" : ""}`} />
          <line x1={x} y1="326" x2={x} y2="350" class={`tie${active.has("soc") ? " is-on" : ""}`} />
        </>
      ))}

      {drawnEdges.map(e => (
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
              class={`edge edge-${e.kind}${e.on ? " is-on" : ""}`}
              marker-end={e.on ? "url(#infra-arrow-on)" : "url(#infra-arrow)"} />
      ))}

      {nodes.map(n => {
        const on = active.has(n.id);
        const labelLines = wrap(n.label, n.w, 6.1);
        const hintLines = wrap(n.hint, n.w, 5.0);
        const blockH = labelLines.length * 14 + hintLines.length * 12;
        let y = n.y + (n.h - blockH) / 2 + 11;
        return (
          <g class={`node${on ? " is-on" : ""}`}>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />
            {labelLines.map((l, i) => (
              <text class="node-label" x={n.x + n.w / 2} y={y + i * 14} text-anchor="middle">{l}</text>
            ))}
            {hintLines.map((l, i) => (
              <text class="node-hint" x={n.x + n.w / 2} y={y + labelLines.length * 14 + i * 12 - 1} text-anchor="middle">{l}</text>
            ))}
          </g>
        );
      })}
    </svg>
  </div>

  <ul class="infra-legend">
    <li><span class="key key-flow"></span>Tráfico y datos</li>
    <li><span class="key key-control"></span>Confianza y política</li>
    <li><span class="key key-on"></span>Capa donde opera</li>
  </ul>

  <div class="infra-notes">
    {items.map(item => (
      <div class="infra-note">
        <p class="infra-note-head">
          {item.nodes.map(id => <span class="infra-chip">{nodeById.get(id)?.label ?? id}</span>)}
          {items.length > 1 && <span class="infra-note-cat">como {item.category}</span>}
        </p>
        <p class="infra-note-body">{item.rationale}</p>
      </div>
    ))}
    {omitted > 0 && (
      <p class="infra-note-more">
        {omitted === 1
          ? "Otra categoría de esta herramienta ocupa el mismo emplazamiento."
          : `Otras ${omitted} categorías de esta herramienta ocupan el mismo emplazamiento.`}
      </p>
    )}
  </div>
</section>

<style>
  .infra{margin-top:40px}
  .infra-lead{font-size:14px;color:#86868b;line-height:1.6;max-width:62ch}
  .infra-canvas{margin-top:14px;border:1px solid #e8e8ed;border-radius:16px;background:#fff;padding:12px;overflow-x:auto}
  .infra-canvas svg{display:block;width:100%;min-width:560px;height:auto}

  .node rect{fill:#fff;stroke:#e5e5ea;stroke-width:1}
  .node .node-label{font-size:11.5px;font-weight:600;fill:#6e6e73}
  .node .node-hint{font-size:9.5px;fill:#aeaeb2}
  .node.is-on rect{fill:#eff6ff;stroke:#0071e3;stroke-width:1.75}
  .node.is-on .node-label{fill:#0055b3}
  .node.is-on .node-hint{fill:#5a9bdc}

  .edge{stroke:#d2d2d7;stroke-width:1.4}
  .edge-control{stroke-dasharray:4 3}
  .edge.is-on{stroke:#0071e3;stroke-width:1.8}
  .tie{stroke:#e5e5ea;stroke-width:1;stroke-dasharray:2 4}
  .tie.is-on{stroke:#9ac5f0}

  .infra-legend{display:flex;flex-wrap:wrap;gap:16px;margin-top:10px;font-size:11.5px;color:#8e8e93;list-style:none;padding:0}
  .infra-legend li{display:flex;align-items:center;gap:6px}
  .key{width:18px;height:0;border-top:1.5px solid #d2d2d7;display:inline-block}
  .key-control{border-top-style:dashed}
  .key-on{border-top-color:#0071e3;border-top-width:2px}

  .infra-notes{margin-top:16px;display:grid;gap:14px}
  .infra-note-head{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
  .infra-chip{display:inline-flex;align-items:center;padding:3px 10px;border-radius:9999px;background:#eff6ff;color:#0055b3;font-size:12px;font-weight:600}
  .infra-note-cat{font-size:12px;color:#aeaeb2}
  .infra-note-body{margin-top:6px;font-size:14px;color:#6e6e73;line-height:1.65;max-width:68ch}
  .infra-note-more{font-size:12.5px;color:#aeaeb2}
</style>
