---
const base = import.meta.env.BASE_URL;
---

<footer class="mt-auto border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-tertiary)]">
  <div class="container-app py-12">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <p class="text-[13px] font-medium text-[var(--color-text-primary)]">BBDD IT Tools</p>
        <p class="mt-1 text-[12px] text-[var(--color-text-tertiary)]">Directorio actualizado cada lunes · 24 herramientas en 15 categorías</p>
      </div>
      <div class="flex gap-6 text-[12px] text-[var(--color-text-secondary)]">
        <a href={`${base}herramientas`} class="hover:text-[var(--color-text-primary)] transition-colors no-underline">Directorio</a>
        <a href={`${base}ranking`} class="hover:text-[var(--color-text-primary)] transition-colors no-underline">Rankings</a>
        <a href={`${base}about`} class="hover:text-[var(--color-text-primary)] transition-colors no-underline">Acerca de</a>
      </div>
    </div>
  </div>
</footer>
