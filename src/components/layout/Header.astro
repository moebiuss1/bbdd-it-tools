---
import SearchBar from "@components/layout/SearchBar.tsx";

const NAV_ITEMS = [
  { label: "Directorio", href: "/herramientas" },
  { label: "Rankings", href: "/ranking" },
  { label: "Categorías", href: "/#categorias" },
  { label: "Acerca de", href: "/about" },
];
---

<header class="sticky top-0 z-50 border-b border-[#e5e5ea] bg-white/80 backdrop-blur-xl">
  <nav class="container-app flex h-14 items-center justify-between">
    <!-- Wordmark -->
    <a
      href="/"
      class="flex items-center gap-2 font-semibold text-[#1d1d1f] no-underline"
      aria-label="BBDD IT Tools — Inicio"
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#0071e3] text-sm font-bold text-white">
        B
      </span>
      <span class="hidden sm:inline">BBDD IT Tools</span>
    </a>

    <!-- Enlaces principales -->
    <div class="hidden items-center gap-1 md:flex">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class="rounded-full px-3 py-1.5 text-sm text-[#6e6e73] transition-colors hover:bg-[#f5f5f7] hover:text-[#1d1d1f]"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Buscador global (isla React) -->
    <div class="w-full max-w-xs ml-4">
      <SearchBar client:load />
    </div>
  </nav>
</header>
