---
const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border-subtle)] bg-white/85 backdrop-blur-xl backdrop-saturate-150">
  <nav class="container-app flex h-12 items-center gap-6">
    <a href={base} class="shrink-0 font-semibold text-[15px] tracking-tight text-[var(--color-text-primary)] no-underline hover:opacity-70 transition-opacity">
      BBDD IT
    </a>
    <div class="hidden items-center gap-1 sm:flex">
      <a href={`${base}herramientas`} class="rounded-full px-3 py-1.5 text-[13px] text-[var(--color-text-secondary)] no-underline hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Directorio</a>
      <a href={`${base}ranking`} class="rounded-full px-3 py-1.5 text-[13px] text-[var(--color-text-secondary)] no-underline hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Rankings</a>
      <a href={`${base}about`} class="rounded-full px-3 py-1.5 text-[13px] text-[var(--color-text-secondary)] no-underline hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Acerca de</a>
    </div>
    <div class="flex-1"></div>
    <form action={`${base}herramientas`} method="get" class="relative w-full max-w-[220px]">
      <svg class="absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[var(--color-text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="search" name="q" placeholder="Buscar" class="w-full rounded-full border border-[var(--color-border)] bg-[var(--color-bg-secondary)] py-1.5 pl-8 pr-3 text-[13px] text-[var(--color-text-primary)] placeholder:text-[var(--color-text-tertiary)] transition focus:border-[var(--color-accent)] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/15" />
    </form>
  </nav>
</header>
