---
import "../styles/global.css";

const { title, description = "Directorio vivo de herramientas IT para seguridad, cumplimiento y auditoría." } = Astro.props;
const base = import.meta.env.BASE_URL;

/**
 * GitHub Pages sirve ficheros estáticos y no permite añadir cabeceras HTTP, así
 * que la política viaja en un <meta http-equiv>. Limitaciones conocidas de esa
 * vía: `frame-ancestors`, `X-Frame-Options` y `X-Content-Type-Options` solo
 * tienen efecto como cabecera real y por eso no se declaran aquí (un proxy o
 * Cloudflare delante del sitio debería añadirlos).
 *
 * `style-src` admite 'unsafe-inline' porque la interfaz usa atributos `style`
 * en muchos componentes; `script-src` no lo necesita: todo el JavaScript del
 * sitio se emite como módulo externo desde /_astro (ver src/scripts/).
 *
 * Solo se emite en el build de producción: el servidor de desarrollo inyecta
 * scripts inline propios (HMR y barra de herramientas de Astro) que esta
 * política bloquearía, dejando la aplicación local sin recarga en caliente.
 * Para comprobar la CSP tal como se publica, usar `npm run preview`.
 */
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  "upgrade-insecure-requests",
].join("; ");
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — BBDD IT Tools`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <title>{title} — BBDD IT Tools</title>
</head>
<body class="flex flex-col" style="min-height:100vh">
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <slot />
</body>
</html>
