---
const { title, description = "Directorio vivo de herramientas IT para seguridad, cumplimiento y auditoría." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title} — BBDD IT Tools`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <title>{title} — BBDD IT Tools</title>
</head>
<body class="flex min-h-screen flex-col bg-white">
  <slot />
  <div id="modal-root"></div>
</body>
</html>
