---
import "../styles/global.css";
import { jsonLdScript } from "@lib/jsonld";

interface Props {
  title: string;
  description?: string;
  /** Ruta local de la imagen social; se resuelve a URL absoluta */
  image?: string;
  /** Grafo(s) schema.org de la página, serializados a JSON-LD */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Directorio vivo de herramientas IT para seguridad, cumplimiento y auditoría.",
  image = "og-image.png",
  jsonLd,
} = Astro.props as Props;

const base = import.meta.env.BASE_URL;
const fullTitle = `${title} — BBDD IT Tools`;

/**
 * Las descripciones vienen del frontmatter de las fichas, con saltos de línea y
 * longitudes de párrafo. En un `<meta>` eso viaja tal cual: saltos incluidos, y
 * cortado a la brava por el buscador. Se normaliza a una línea y se recorta por
 * la última palabra que quepa.
 */
function metaText(raw: string, max = 200): string {
  const clean = raw.replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max - 1);
  return cut.slice(0, cut.lastIndexOf(" ")).replace(/[.,;:·—-]$/, "") + "…";
}

/**
 * Las URL absolutas se derivan de `site` + `base` (astro.config.mjs). Se
 * calculan aquí y no en cada página porque un canonical mal formado es
 * indetectable a ojo y duplica el sitio entero a los buscadores.
 */
const metaDescription = metaText(description);
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://moebiuss1.github.io").toString();
const ogImage = new URL(`${base}${image.replace(/^\//, "")}`, Astro.site ?? "https://moebiuss1.github.io").toString();

/**
 * GitHub Pages sirve ficheros estáticos y no permite añadir cabeceras HTTP, así
 * que la política viaja en un <meta http-equiv>. Limitaciones conocidas de esa
 * vía: `frame-ancestors`, `X-Frame-Options` y `X-Content-Type-Options` solo
 * tienen efecto como cabecera real y por eso no se declaran aquí (un proxy o
 * Cloudflare delante del sitio debería añadirlos).
 *
 * `style-src` admite 'unsafe-inline' porque la interfaz usa atributos `style`
 * en muchos componentes; `script-src` no lo necesita: todo el JavaScript del
 * sitio se emite como módulo externo desde /_astro (ver src/scripts/). Los
 * bloques `application/ld+json` no son ejecutables y el navegador no los somete
 * a `script-src`, así que la política sigue siendo estricta con ellos dentro.
 *
 * Solo se emite en el build de producción: el servidor de desarrollo inyecta
 * scripts inline propios (HMR y barra de herramientas de Astro) que esta
 * política bloquearía, dejando la aplicación local sin recarga en caliente.
 * Para comprobar la CSP tal como se publica, usar `npm run preview`.
 */
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  "upgrade-insecure-requests",
].join("; ");

const graphs = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <meta name="theme-color" content="#ffffff" />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="BBDD IT Tools" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="BBDD IT Tools — directorio de herramientas IT para seguridad, cumplimiento y auditoría" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <link rel="alternate" type="application/rss+xml" title="Novedades de BBDD IT Tools" href={`${base}rss.xml`} />

  {graphs.map(g => <script type="application/ld+json" is:inline set:html={jsonLdScript(g)} />)}
</head>
<body class="flex flex-col" style="min-height:100vh">
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <slot />
</body>
</html>
