---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();
const url = Astro.url;
const q = (url.searchParams.get("q") ?? "").toLowerCase();
const catFilter = url.searchParams.get("category") ?? "";
const typeFilter = url.searchParams.get("type") ?? "";
const tagFilter = url.searchParams.get("tag") ?? "";
const sortBy = url.searchParams.get("sort") ?? "rank";
let filtered = tools;
if (q) filtered = filtered.filter(t => t.data.name.toLowerCase().includes(q) || t.data.description.toLowerCase().includes(q) || t.data.tags.some(tag => tag.toLowerCase().includes(q)));
if (catFilter) filtered = filtered.filter(t => t.data.category === catFilter);
if (typeFilter) filtered = filtered.filter(t => t.data.type === typeFilter);
if (tagFilter) filtered = filtered.filter(t => t.data.tags.includes(tagFilter));
filtered.sort((a,b) => { if (sortBy==="name") return a.data.name.localeCompare(b.data.name,"es"); if (sortBy==="updated") { const da=a.data.last_verified?new Date(a.data.last_verified).getTime():0; const db=b.data.last_verified?new Date(b.data.last_verified).getTime():0; return db-da; } return (a.data.market_rank??999)-(b.data.market_rank??999); });
const hasFilters = !!(q||catFilter||typeFilter||tagFilter);
---

<BaseLayout title="Directorio">
  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}about`} class="nav-link">Acerca de</a></div>
    </nav>
  </header>

  <section class="py-10">
    <div class="container">
      <h1 class="section-title" style="font-size:28px">Directorio</h1>
      <p class="section-desc">{tools.length} herramientas en {categories.length} categorías</p>
      <div class="flex flex-wrap gap-2 mt-8">
        <a href={`${base}herramientas`} class={`badge badge-md ${!catFilter?'badge-blue':'badge-outline'}`}>Todas</a>
        {categories.map(c => <a href={`${base}herramientas?category=${c.id}`} class={`badge badge-md ${catFilter===c.id?'badge-blue':'badge-outline'}`}>{c.name}</a>)}
      </div>
      <div class="flex flex-wrap items-center gap-3 mt-5" style="font-size:13px">
        <a href={`${base}herramientas${q?'?q='+q:''}`} class={`badge badge-md ${!typeFilter?'badge-blue':'badge-outline'}`}>Todos</a>
        <a href={`${base}herramientas?type=comercial${q?'&q='+q:''}`} class={`badge badge-md ${typeFilter==='comercial'?'badge-blue':'badge-outline'}`}>Comercial</a>
        <a href={`${base}herramientas?type=opensource${q?'&q='+q:''}`} class={`badge badge-md ${typeFilter==='opensource'?'badge-blue':'badge-outline'}`}>Open Source</a>
        <span style="color:#d2d2d7;margin:0 4px" class="hidden sm:inline">|</span>
        <a href={`${base}herramientas?sort=rank`} style={`color:${sortBy==='rank'?'#1d1d1f':'#86868b'};font-weight:${sortBy==='rank'?'500':'400'}`}>Por ranking</a>
        <a href={`${base}herramientas?sort=name`} style={`color:${sortBy==='name'?'#1d1d1f':'#86868b'};font-weight:${sortBy==='name'?'500':'400'}`}>Alfabético</a>
        <a href={`${base}herramientas?sort=updated`} style={`color:${sortBy==='updated'?'#1d1d1f':'#86868b'};font-weight:${sortBy==='updated'?'500':'400'}`}>Más reciente</a>
      </div>
      <div class="flex items-center gap-3 mt-4" style="font-size:13px;color:#86868b">
        <span>{filtered.length} resultado{filtered.length!==1?'s':''}{hasFilters?' con filtros':''}</span>
        {hasFilters && <a href={`${base}herramientas`} style="color:#0071e3">Limpiar filtros</a>}
      </div>

      {filtered.length===0 ? <div class="text-center py-16"><p class="section-desc">Sin resultados. Prueba otros filtros.</p><a href={`${base}herramientas`} class="btn btn-primary mt-4">Ver todas</a></div> :
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-8">
        {filtered.map(t => (
          <a href={`${base}herramientas/${t.slug}`} class="card tool-card group">
            <div class="tool-avatar">{t.data.name.charAt(0)}</div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2"><h3 class="tool-name" style="color:#1d1d1f">{t.data.name}</h3>{t.data.market_rank&&t.data.market_rank<=3&&<span class="badge badge-amber badge-sm">#{t.data.market_rank}</span>}</div>
              <p class="tool-desc">{t.data.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <span class={`badge badge-sm ${t.data.type==='opensource'?'badge-green':'badge-blue'}`}>{t.data.type==='opensource'?'Open Source':'Comercial'}</span>
                {t.data.company_size.slice(0,2).map((s:string) => <span class="badge badge-gray badge-sm">{s.charAt(0).toUpperCase()+s.slice(1)}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>}
    </div>
  </section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>
