---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getTagCounts, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();

// Puntuación unificada (misma fórmula que en [slug].astro)
function computeScore(d: any) {
  const rs = d.market_rank ? Math.max(0, 40 - ((d.market_rank - 1) * 5)) : 10;
  const cs = Math.min((d.certifications?.length ?? 0) * 6, 30);
  const ss = Math.min((d.sources?.length ?? 0) * 5, 20);
  const fs = d.last_verified ? (() => { const days = (Date.now() - new Date(d.last_verified).getTime()) / 86400000; return days < 30 ? 10 : days < 90 ? 7 : days < 180 ? 5 : 3; })() : 0;
  return Math.min(100, rs + cs + ss + fs);
}

// Ordenar por ranking
const sortedTools = [...tools].sort((a,b) => (a.data.market_rank??999) - (b.data.market_rank??999));
const groupByCat = categories.map(cat => ({
  ...cat,
  tools: sortedTools.filter(t => (t.data.categories || [t.data.category]).includes(cat.id))
})).filter(c => c.tools.length > 0);

// Mapa de familia para cada categoría
const familiesMod = await import("@data/categories");
const familyMap = new Map(familiesMod.families.map((f: any) => [f.id, f]));

function scoreColor(s: number) { return s >= 70 ? '#059669' : s >= 40 ? '#d97706' : '#dc2626'; }
function scoreBg(s: number) { return s >= 70 ? '#ecfdf5' : s >= 40 ? '#fffbeb' : '#fef2f2'; }

// Certificaciones rápidas
const quickCerts = ['ISO 27001', 'ENS Alta', 'ENS Media', 'SOC 2 Tipo II', 'Common Criteria'];
---

<BaseLayout title="Directorio">
  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}glosario`} class="nav-link">Glosario</a><a href={`${base}about`} class="nav-link">Acerca de</a></div>
    </nav>
  </header>

  <section class="py-10">
    <div class="container max-w-900" style="overflow-x:hidden">
      <h1 class="section-title" style="font-size:28px">Directorio</h1>
      <p class="section-desc">{tools.length} herramientas en {categories.length} categorías</p>

      <!-- Filtros unificados: categoría + tipo como chips -->
      <div class="mt-8">
        <label style="font-size:11px;color:#8e8e93;display:block;margin-bottom:6px">Categoría</label>
        <div class="flex flex-wrap gap-1.5">
          <button class="filter-chip active" data-cat="">Todas</button>
          {categories.map(c => <button class="filter-chip" data-cat={c.id}>{c.name}</button>)}
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 mt-3">
        <div class="flex flex-wrap items-center gap-3">
          <span style="font-size:11px;color:#8e8e93">Tipo:</span>
          <button class="filter-chip-sm active" data-type="">Todos</button>
          <button class="filter-chip-sm" data-type="comercial">Comercial</button>
          <button class="filter-chip-sm" data-type="opensource">Open Source</button>
          <span style="color:#d2d2d7;margin:0 2px">|</span>
          <button class="sort-link active" data-sort="rank">Por ranking</button>
          <button class="sort-link" data-sort="score">Por puntuación</button>
          <button class="sort-link" data-sort="name">Alfabético</button>
          <span style="color:#d2d2d7;margin:0 2px">|</span>
          <span style="font-size:11px;color:#8e8e93">Cert:</span>
          <button class="filter-chip-sm active" data-qcert="">Todas</button>
          {quickCerts.map(c => <button class="filter-chip-sm" data-qcert={c}>{c}</button>)}
        </div>
        <a href={`${base}herramientas`} id="clear-filters" style="color:#0071e3;font-size:12px;display:none">Limpiar filtros</a>
      </div>
      <div style="font-size:15px;font-weight:600;color:#0071e3;margin-top:12px" id="results-count">{tools.length} herramientas</div>

      <!-- Grid agrupado por categorías -->
      <div id="tools-grid" class="space-y-10 mt-6">
        {groupByCat.map(cat => (
          <section data-cat={cat.id}>
            <h2 class="section-title mb-4">{cat.name} <span style="color:#8e8e93;font-weight:400">{cat.tools.length}</span></h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {cat.tools.map(tool => {
                const s = computeScore(tool.data);
                return (
                  <a href={`${base}herramientas/${tool.slug}/`} class="card tool-card group" data-certs={(tool.data.certifications || []).join(',')}>
                    <div class="tool-avatar">
                      {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt="" width="35" height="35" style="border-radius:10px;object-fit:contain" loading="lazy" /> : <span style="font-size:15px;font-weight:700;color:#8e8e93">{tool.data.name.charAt(0)}</span>}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2"><h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>{tool.data.market_rank&&tool.data.market_rank<=3&&<span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}</div>
                      <p class="tool-desc">{tool.data.description}</p>
                      <div class="flex flex-wrap items-center gap-1.5 mt-2">
                        <span class={`badge badge-sm ${tool.data.type==='opensource'?'badge-green':'badge-blue'}`}>{tool.data.type==='opensource'?'Open Source':'Comercial'}</span>
                        <span class="badge badge-sm" style={`background:${scoreBg(s)};color:${scoreColor(s)}`}>{s}/100</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Empty state (hidden initially) -->
      <div class="text-center py-16" id="empty-state" style="display:none">
        <p class="section-desc">Sin resultados. Prueba otros filtros.</p>
        <a href={`${base}herramientas`} class="btn btn-primary mt-4">Ver todas</a>
      </div>
    </div>
  </section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}glosario`} class="nav-link" style="font-size:12px">Glosario</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>

<style>
.filter-chip{padding:6px 14px;border-radius:9999px;font-size:13px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip:hover{background:#f5f5f7}
.filter-chip.active{background:#e8f2fd;color:#0066cc;border-color:#e8f2fd}
.filter-chip-sm{padding:4px 10px;border-radius:9999px;font-size:11px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip-sm:hover{background:#f5f5f7}
.filter-chip-sm.active{background:#f0fdfa;color:#0d9488;border-color:#f0fdfa}
.sort-link{padding:4px 8px;border-radius:6px;font-size:13px;font-weight:500;color:#6e6e73;background:none;border:none;cursor:pointer;transition:all .15s}
.sort-link:hover{color:#1d1d1f}
.sort-link.active{color:#1d1d1f;font-weight:600}
</style>

<script>
  // @ts-nocheck
  let activeCat = '', activeType = '', activeCert = '', activeSort = 'rank';

  function countVisible() {
    let total = 0;
    document.querySelectorAll('#tools-grid > section').forEach(s => {
      let n = 0;
      s.querySelectorAll('.tool-card').forEach(c => {
        const show = (!activeCat || c.dataset.cat === activeCat)
          && (!activeType || c.dataset.type === activeType)
          && (!activeCert || (c.dataset.certs || '').toLowerCase().includes(activeCert.toLowerCase()));
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      s.style.display = n > 0 ? '' : 'none';
      total += n;
    });
    document.getElementById('results-count').textContent = total + ' herramienta' + (total !== 1 ? 's' : '');
    document.getElementById('clear-filters').style.display = (activeCat || activeType || activeCert) ? '' : 'none';
    document.getElementById('empty-state').style.display = total === 0 ? '' : 'none';
  }

  function updateUI() {
    document.querySelectorAll('.filter-chip[data-cat]').forEach(b => b.classList.toggle('active', b.dataset.cat === activeCat));
    document.querySelectorAll('.filter-chip-sm[data-type]').forEach(b => b.classList.toggle('active', b.dataset.type === activeType));
    document.querySelectorAll('.filter-chip-sm[data-qcert]').forEach(b => b.classList.toggle('active', b.dataset.qcert === activeCert));
    document.querySelectorAll('.sort-link').forEach(b => b.classList.toggle('active', b.dataset.sort === activeSort));
  }

  // Setup data attributes on cards
  document.querySelectorAll('.tool-card').forEach(card => {
    const section = card.closest('section');
    if (section) card.dataset.cat = section.dataset.cat;
    card.dataset.type = card.querySelector('.badge-green') ? 'opensource' : card.querySelector('.badge-blue') ? 'comercial' : '';
  });

  // Event delegation
  document.addEventListener('click', function(e) {
    // Category chips
    const cchip = e.target.closest('.filter-chip[data-cat]');
    if (cchip) {
      e.preventDefault();
      activeCat = activeCat === cchip.dataset.cat ? '' : cchip.dataset.cat;
      updateUI(); countVisible(); return;
    }
    // Type chips
    const tchip = e.target.closest('.filter-chip-sm[data-type]');
    if (tchip) {
      e.preventDefault();
      activeType = activeType === tchip.dataset.type ? '' : tchip.dataset.type;
      updateUI(); countVisible(); return;
    }
    // Cert chips
    const qchip = e.target.closest('.filter-chip-sm[data-qcert]');
    if (qchip) {
      e.preventDefault();
      activeCert = activeCert === qchip.dataset.qcert ? '' : qchip.dataset.qcert;
      updateUI(); countVisible(); return;
    }
    // Sort links
    const slink = e.target.closest('.sort-link');
    if (slink) {
      e.preventDefault();
      activeSort = slink.dataset.sort;
      updateUI(); countVisible(); return;
    }
    // Clear
    if (e.target.closest('#clear-filters')) {
      e.preventDefault();
      activeCat = ''; activeType = ''; activeCert = ''; activeSort = 'rank';
      updateUI(); countVisible(); return;
    }
  });

  updateUI();
</script>
