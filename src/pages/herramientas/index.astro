---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getToolCategories, computeToolScore, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();

// Ordenar por ranking
const sortedTools = [...tools].sort((a,b) => (a.data.market_rank??999) - (b.data.market_rank??999));
const groupByCat = categories.map(cat => ({
  ...cat,
  tools: sortedTools.filter(t => getToolCategories(t.data).includes(cat.id))
})).filter(c => c.tools.length > 0);

function scoreColor(s: number) { return s >= 70 ? '#059669' : s >= 40 ? '#d97706' : '#dc2626'; }
function scoreBg(s: number) { return s >= 70 ? '#ecfdf5' : s >= 40 ? '#fffbeb' : '#fef2f2'; }

// Certificaciones rápidas
const quickCerts = ['ISO 27001', 'ENS Alta', 'ENS Media', 'SOC 2 Tipo II', 'Common Criteria'];
---

<BaseLayout title="Directorio">
  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}glosario`} class="nav-link">Glosario</a><a href={`${base}about`} class="nav-link">Acerca de</a></div>
    </nav>
  </header>

  <section class="py-10">
    <div class="container max-w-900" style="overflow-x:hidden">
      <h1 class="section-title" style="font-size:28px">Directorio</h1>
      <p class="section-desc">{tools.length} herramientas en {categories.length} categorías</p>

      <!-- Búsqueda -->
      <div class="mt-6" style="max-width:420px;position:relative">
        <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);pointer-events:none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8e8e93" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="tool-search" class="search-input" style="padding-left:32px;font-size:14px" placeholder="Buscar por nombre, descripción, etiqueta o certificación..." aria-label="Buscar herramientas" />
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap items-end gap-3 mt-6">
        <div>
          <label for="cat-select" style="font-size:11px;color:#8e8e93;display:block;margin-bottom:4px">Categoría</label>
          <select id="cat-select" style="padding:8px 32px 8px 12px;border:1px solid #d2d2d7;border-radius:10px;font-size:14px;font-weight:500;color:#1d1d1f;background:#fff;appearance:none;-webkit-appearance:none;cursor:pointer;outline:none;max-width:260px">
            <option value="">Todas las categorías</option>
            {categories.map(c => <option value={c.id}>{c.name} ({tools.filter(t=>getToolCategories(t.data).includes(c.id)).length})</option>)}
          </select>
        </div>
        <div>
          <span style="font-size:11px;color:#8e8e93">Tipo:</span>
          <button class="filter-chip-sm active" data-type="" aria-pressed="true">Todos</button>
          <button class="filter-chip-sm" data-type="comercial" aria-pressed="false">Comercial</button>
          <button class="filter-chip-sm" data-type="opensource" aria-pressed="false">Open Source</button>
        </div>
        <span style="color:#d2d2d7;margin:0 2px">|</span>
        <button class="sort-link active" data-sort="rank" aria-pressed="true">Por ranking</button>
        <button class="sort-link" data-sort="score" aria-pressed="false">Por puntuación</button>
        <button class="sort-link" data-sort="name" aria-pressed="false">Alfabético</button>
        <button class="sort-link" data-sort="updated" aria-pressed="false">Más recientes</button>
        <span style="color:#d2d2d7;margin:0 2px">|</span>
        <span style="font-size:11px;color:#8e8e93">Cert:</span>
        <button class="filter-chip-sm active" data-qcert="" aria-pressed="true">Todas</button>
        {quickCerts.map(c => <button class="filter-chip-sm" data-qcert={c} aria-pressed="false">{c}</button>)}
        <a href={`${base}herramientas`} id="clear-filters" style="color:#0071e3;font-size:12px;display:none;margin-left:4px">Limpiar filtros</a>
      </div>
      <div style="font-size:15px;font-weight:600;color:#0071e3;margin-top:12px" id="results-count" aria-live="polite">{tools.length} herramientas</div>

      <!-- Grid agrupado por categorías -->
      <div id="tools-grid" class="space-y-10 mt-6">
        {groupByCat.map(cat => (
          <section data-cat={cat.id}>
            <h2 class="section-title mb-4">{cat.name} <span style="color:#8e8e93;font-weight:400">{cat.tools.length}</span></h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {cat.tools.map(tool => {
                const s = computeToolScore(tool.data);
                return (
                  <a href={`${base}herramientas/${tool.slug}/`} class="card tool-card group"
                     data-slug={tool.slug}
                     data-name={tool.data.name}
                     data-rank={tool.data.market_rank ?? 999}
                     data-score={s}
                     data-updated={tool.data.last_verified ? new Date(tool.data.last_verified).getTime() : 0}
                     data-certs={(tool.data.certifications || []).join(',')}
                     data-tags={(tool.data.tags || []).join(',')}>
                    <div class="tool-avatar">
                      {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt="" width="35" height="35" style="border-radius:10px;object-fit:contain" loading="lazy" /> : <span style="font-size:15px;font-weight:700;color:#8e8e93">{tool.data.name.charAt(0)}</span>}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2"><h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>{tool.data.market_rank&&tool.data.market_rank<=3&&<span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}</div>
                      <p class="tool-desc">{tool.data.description}</p>
                      <div class="flex flex-wrap items-center gap-1.5 mt-2">
                        <span class={`badge badge-sm ${tool.data.type==='opensource'?'badge-green':'badge-blue'}`}>{tool.data.type==='opensource'?'Open Source':'Comercial'}</span>
                        <span class="badge badge-sm" style={`background:${scoreBg(s)};color:${scoreColor(s)}`}>{s}/100</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Empty state (hidden initially) -->
      <div class="text-center py-16" id="empty-state" style="display:none">
        <p class="section-desc" id="empty-state-msg">Sin resultados. Prueba otros filtros.</p>
        <a href={`${base}herramientas`} class="btn btn-primary mt-4">Ver todas</a>
      </div>
    </div>
  </section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}glosario`} class="nav-link" style="font-size:12px">Glosario</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>

<style>
.filter-chip{padding:6px 14px;border-radius:9999px;font-size:13px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip:hover{background:#f5f5f7}
.filter-chip.active{background:#e8f2fd;color:#0066cc;border-color:#e8f2fd}
.filter-chip-sm{padding:4px 10px;border-radius:9999px;font-size:11px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip-sm:hover{background:#f5f5f7}
.filter-chip-sm.active{background:#f0fdfa;color:#0d9488;border-color:#f0fdfa}
.sort-link{padding:4px 8px;border-radius:6px;font-size:13px;font-weight:500;color:#6e6e73;background:none;border:none;cursor:pointer;transition:all .15s}
.sort-link:hover{color:#1d1d1f}
.sort-link.active{color:#1d1d1f;font-weight:600}
</style>

<script>
  import { loadIndex } from "@lib/search";

  const BASE = document.querySelector('a.brand')?.getAttribute('href') || '/';
  const params = new URLSearchParams(location.search);

  let activeCat = params.get('cat') || '';
  let activeType = params.get('type') || '';
  let activeCert = params.get('cert') || '';
  let activeTag = params.get('tag') || '';
  let activeSort = params.get('sort') || 'rank';
  let query = params.get('q') || '';
  let matchedSlugs: Set<string> | null = null;

  const catSelect = document.getElementById('cat-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
  const resultsCount = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');
  const emptyStateMsg = document.getElementById('empty-state-msg');
  const clearFilters = document.getElementById('clear-filters');

  if (catSelect) catSelect.value = activeCat;
  if (searchInput) searchInput.value = query;

  let miniSearchPromise: Promise<any> | null = null;
  async function getMiniSearch() {
    if (!miniSearchPromise) {
      miniSearchPromise = fetch(`${BASE}search-index.json`)
        .then(r => r.text())
        .then(json => loadIndex(json))
        .catch(() => null);
    }
    return miniSearchPromise;
  }

  async function runSearch(q: string) {
    const trimmed = q.trim();
    if (!trimmed) { matchedSlugs = null; render(); return; }
    const mini = await getMiniSearch();
    if (!mini) { matchedSlugs = null; render(); return; }
    const results = mini.search(trimmed);
    matchedSlugs = new Set(results.map((r: any) => r.slug));
    render();
  }

  function applySort() {
    document.querySelectorAll<HTMLElement>('#tools-grid > section').forEach(section => {
      const grid = section.querySelector('.grid');
      if (!grid) return;
      const cards = Array.from(grid.children) as HTMLElement[];
      cards.sort((a, b) => {
        if (activeSort === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'es');
        if (activeSort === 'score') return Number(b.dataset.score) - Number(a.dataset.score);
        if (activeSort === 'updated') return Number(b.dataset.updated) - Number(a.dataset.updated);
        return Number(a.dataset.rank || 999) - Number(b.dataset.rank || 999);
      });
      cards.forEach(c => grid.appendChild(c));
    });
  }

  function render() {
    let total = 0;
    document.querySelectorAll<HTMLElement>('#tools-grid > section').forEach(section => {
      let n = 0;
      section.querySelectorAll<HTMLElement>('.tool-card').forEach(card => {
        const certs = (card.dataset.certs || '').toLowerCase();
        const tags = (card.dataset.tags || '').split(',');
        const show = (!activeCat || section.dataset.cat === activeCat)
          && (!activeType || card.dataset.type === activeType)
          && (!activeCert || certs.includes(activeCert.toLowerCase()))
          && (!activeTag || tags.includes(activeTag))
          && (matchedSlugs === null || matchedSlugs.has(card.dataset.slug || ''));
        card.style.display = show ? '' : 'none';
        if (show) n++;
      });
      section.style.display = n > 0 ? '' : 'none';
      total += n;
    });
    applySort();
    if (resultsCount) resultsCount.textContent = total + ' herramienta' + (total !== 1 ? 's' : '');
    if (clearFilters) clearFilters.style.display = (activeCat || activeType || activeCert || activeTag || query) ? '' : 'none';
    if (emptyState) emptyState.style.display = total === 0 ? '' : 'none';
    if (emptyStateMsg) {
      emptyStateMsg.textContent = activeTag
        ? `Sin resultados para la etiqueta "${activeTag}".`
        : query
        ? `Sin resultados para "${query}".`
        : 'Sin resultados. Prueba otros filtros.';
    }
  }

  function updateUI() {
    document.querySelectorAll<HTMLElement>('.filter-chip-sm[data-type]').forEach(b => {
      const active = b.dataset.type === activeType;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    document.querySelectorAll<HTMLElement>('.filter-chip-sm[data-qcert]').forEach(b => {
      const active = b.dataset.qcert === activeCert;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    document.querySelectorAll<HTMLElement>('.sort-link').forEach(b => {
      const active = b.dataset.sort === activeSort;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
  }

  function syncURL() {
    const p = new URLSearchParams();
    if (activeCat) p.set('cat', activeCat);
    if (activeType) p.set('type', activeType);
    if (activeCert) p.set('cert', activeCert);
    if (activeTag) p.set('tag', activeTag);
    if (activeSort !== 'rank') p.set('sort', activeSort);
    if (query) p.set('q', query);
    const qs = p.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
  }

  // Data attribute inicial: tipo (derivado del badge) y categoría
  document.querySelectorAll<HTMLElement>('.tool-card').forEach(card => {
    const section = card.closest('section');
    if (section) card.dataset.cat = (section as HTMLElement).dataset.cat;
    card.dataset.type = card.querySelector('.badge-green') ? 'opensource' : card.querySelector('.badge-blue') ? 'comercial' : '';
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const tchip = target.closest('.filter-chip-sm[data-type]') as HTMLElement | null;
    if (tchip) {
      e.preventDefault();
      activeType = activeType === tchip.dataset.type ? '' : (tchip.dataset.type || '');
      updateUI(); render(); syncURL(); return;
    }
    const qchip = target.closest('.filter-chip-sm[data-qcert]') as HTMLElement | null;
    if (qchip) {
      e.preventDefault();
      activeCert = activeCert === qchip.dataset.qcert ? '' : (qchip.dataset.qcert || '');
      updateUI(); render(); syncURL(); return;
    }
    const slink = target.closest('.sort-link') as HTMLElement | null;
    if (slink) {
      e.preventDefault();
      activeSort = slink.dataset.sort || 'rank';
      updateUI(); render(); syncURL(); return;
    }
    if (target.closest('#clear-filters')) {
      e.preventDefault();
      activeCat = ''; activeType = ''; activeCert = ''; activeTag = ''; activeSort = 'rank'; query = '';
      if (catSelect) catSelect.value = '';
      if (searchInput) searchInput.value = '';
      matchedSlugs = null;
      updateUI(); render(); syncURL(); return;
    }
  });

  catSelect?.addEventListener('change', () => {
    activeCat = catSelect.value;
    render(); syncURL();
  });

  let searchDebounce: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => { runSearch(query); syncURL(); }, 150);
  });

  updateUI();
  if (query) { runSearch(query); } else { render(); }
</script>
