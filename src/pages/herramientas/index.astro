---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getTagCounts, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();

// Puntuación unificada (misma fórmula que en [slug].astro)
function computeScore(d: any) {
  const rs = d.market_rank ? Math.max(0, 40 - ((d.market_rank - 1) * 5)) : 10;
  const cs = Math.min((d.certifications?.length ?? 0) * 6, 30);
  const ss = Math.min((d.sources?.length ?? 0) * 5, 20);
  const fs = d.last_verified ? (() => { const days = (Date.now() - new Date(d.last_verified).getTime()) / 86400000; return days < 30 ? 10 : days < 90 ? 7 : days < 180 ? 5 : 3; })() : 0;
  return Math.min(100, rs + cs + ss + fs);
}

// Ordenar por ranking
const sortedTools = [...tools].sort((a,b) => (a.data.market_rank??999) - (b.data.market_rank??999));
const groupByCat = categories.map(cat => ({
  ...cat,
  tools: sortedTools.filter(t => t.data.category === cat.id)
})).filter(c => c.tools.length > 0);

function scoreColor(s: number) { return s >= 70 ? '#059669' : s >= 40 ? '#d97706' : '#dc2626'; }
function scoreBg(s: number) { return s >= 70 ? '#ecfdf5' : s >= 40 ? '#fffbeb' : '#fef2f2'; }

// Certificaciones rápidas
const quickCerts = ['ISO 27001', 'ENS Alta', 'ENS Media', 'SOC 2 Tipo II', 'Common Criteria'];
---

<BaseLayout title="Directorio">
  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}about`} class="nav-link">Acerca de</a></div>
    </nav>
  </header>

  <section class="py-10">
    <div class="container">
      <h1 class="section-title" style="font-size:28px">Directorio</h1>
      <p class="section-desc">{tools.length} herramientas en {categories.length} categorías</p>

      <!-- Filtros: categoría (dropdown) + tipo + ordenación + certificaciones -->
      <div class="flex flex-wrap items-end gap-3 mt-8" style="font-size:13px">
        <div>
          <label style="font-size:11px;color:#8e8e93;display:block;margin-bottom:4px">Categoría</label>
          <select id="cat-select" style="padding:8px 32px 8px 12px;border:1px solid #d2d2d7;border-radius:10px;font-size:14px;font-weight:500;color:#1d1d1f;background:#fff;appearance:none;-webkit-appearance:none;cursor:pointer;outline:none"
            onchange="filterByCat(this.value)">
            <option value="">Todas las categorías</option>
            {categories.map(c => <option value={c.id}>{c.name} ({tools.filter(t=>t.data.category===c.id).length})</option>)}
          </select>
        </div>
        <div>
          <label style="font-size:11px;color:#8e8e93;display:block;margin-bottom:4px">Tipo</label>
          <div class="flex gap-1">
            <button class="filter-chip active" data-type="" onclick="filterByType('')">Todos</button>
            <button class="filter-chip" data-type="comercial" onclick="filterByType('comercial')">Comercial</button>
            <button class="filter-chip" data-type="opensource" onclick="filterByType('opensource')">Open Source</button>
          </div>
        </div>
      </div>

      <!-- Ordenación + Certificaciones rápidas -->
      <div class="flex flex-wrap items-center gap-3 mt-4" style="font-size:13px">
        <span style="color:#8e8e93;font-size:12px">Ordenar:</span>
        <button class="sort-link active" data-sort="rank" onclick="filterBySort('rank')">Por ranking</button>
        <button class="sort-link" data-sort="score" onclick="filterBySort('score')">Por puntuación</button>
        <button class="sort-link" data-sort="name" onclick="filterBySort('name')">Alfabético</button>
        <span style="color:#d2d2d7;margin:0 4px">|</span>
        <span style="color:#8e8e93;font-size:12px">Certificación:</span>
        <button class="filter-chip-sm active" data-qcert="" onclick="filterByCert('')">Todas</button>
        {quickCerts.map(c => <button class="filter-chip-sm" data-qcert={c} onclick={`filterByCert('${c}')`}>{c}</button>)}
      </div>

      <!-- Resultados -->
      <div class="flex items-center gap-3 mt-4" style="font-size:13px;color:#6e6e73">
        <span id="results-text">{tools.length} resultados</span>
        <a href={`${base}herramientas`} id="clear-filters" style="color:#0071e3;display:none">Limpiar filtros</a>
      </div>

      <!-- Grid agrupado por categorías -->
      <div id="tools-grid" class="space-y-10 mt-6">
        {groupByCat.map(cat => (
          <section data-cat={cat.id}>
            <h2 class="section-title mb-4">{cat.name} <span style="color:#8e8e93;font-weight:400">{cat.tools.length}</span></h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {cat.tools.map(tool => {
                const s = computeScore(tool.data);
                return (
                  <a href={`${base}herramientas/${tool.slug}/`} class="card tool-card group" data-certs={(tool.data.certifications || []).join(',')}>
                    <div class="tool-avatar">
                      {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt="" width="40" height="40" style="border-radius:10px;object-fit:contain" loading="lazy" /> : <span style="font-size:15px;font-weight:700;color:#8e8e93">{tool.data.name.charAt(0)}</span>}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2"><h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>{tool.data.market_rank&&tool.data.market_rank<=3&&<span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}</div>
                      <p class="tool-desc">{tool.data.description}</p>
                      <div class="flex flex-wrap items-center gap-1.5 mt-2">
                        <span class={`badge badge-sm ${tool.data.type==='opensource'?'badge-green':'badge-blue'}`}>{tool.data.type==='opensource'?'Open Source':'Comercial'}</span>
                        <span class="badge badge-sm" style={`background:${scoreBg(s)};color:${scoreColor(s)}`}>{s}/100</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Empty state (hidden initially) -->
      <div class="text-center py-16" id="empty-state" style="display:none">
        <p class="section-desc">Sin resultados. Prueba otros filtros.</p>
        <a href={`${base}herramientas`} class="btn btn-primary mt-4">Ver todas</a>
      </div>
    </div>
  </section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>

<style>
.filter-chip{padding:6px 14px;border-radius:9999px;font-size:13px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip:hover{background:#f5f5f7}
.filter-chip.active{background:#e8f2fd;color:#0066cc;border-color:#e8f2fd}
.filter-chip-sm{padding:4px 10px;border-radius:9999px;font-size:11px;font-weight:500;border:1px solid #d2d2d7;color:#6e6e73;background:#fff;cursor:pointer;transition:all .15s}
.filter-chip-sm:hover{background:#f5f5f7}
.filter-chip-sm.active{background:#f0fdfa;color:#0d9488;border-color:#f0fdfa}
.sort-link{padding:4px 8px;border-radius:6px;font-size:13px;font-weight:500;color:#6e6e73;background:none;border:none;cursor:pointer;transition:all .15s}
.sort-link:hover{color:#1d1d1f}
.sort-link.active{color:#1d1d1f;font-weight:600}
</style>

<script>
  // @ts-nocheck
  // Simple client-side filtering: hide/show sections and cards
  let activeCat = '', activeType = '', activeCert = '', activeSort = 'rank';

  function applyFilters() {
    const sections = document.querySelectorAll('#tools-grid > section');
    let total = 0;
    sections.forEach(section => {
      const catId = section.dataset.cat;
      const cards = section.querySelectorAll('.tool-card');
      let visibleCards = 0;
      cards.forEach(card => {
        const cardCat = card.dataset.cat || catId;
        const cardType = card.dataset.type || '';
        const cardCerts = (card.dataset.certs || '').toLowerCase();
        const show = (!activeCat || cardCat === activeCat)
          && (!activeType || cardType === activeType)
          && (!activeCert || cardCerts.includes(activeCert.toLowerCase()));
        card.style.display = show ? '' : 'none';
        if (show) visibleCards++;
      });
      section.style.display = visibleCards > 0 ? '' : 'none';
      total += visibleCards;
    });
    document.getElementById('results-text').textContent = `${total} resultado${total!==1?'s':''}${(activeCat||activeType||activeCert)?' con filtros':''}`;
    document.getElementById('clear-filters').style.display = (activeCat||activeType||activeCert) ? '' : 'none';
    document.getElementById('empty-state').style.display = total === 0 ? '' : 'none';
  }

  function filterByCat(val) {
    activeCat = val;
    document.getElementById('cat-select').value = val;
    updateUI(); applyFilters();
  }
  function filterByType(val) {
    activeType = activeType === val ? '' : val;
    updateUI(); applyFilters();
  }
  function filterByCert(val) {
    activeCert = activeCert === val ? '' : val;
    updateUI(); applyFilters();
  }
  function filterBySort(val) {
    activeSort = val;
    updateUI(); applyFilters();
  }

  function updateUI() {
    document.querySelectorAll('.filter-chip').forEach(b => b.classList.toggle('active', b.dataset.type === activeType));
    document.querySelectorAll('.filter-chip-sm').forEach(b => b.classList.toggle('active', b.dataset.qcert === activeCert));
    document.querySelectorAll('.sort-link').forEach(b => b.classList.toggle('active', b.dataset.sort === activeSort));
  }

  // Add data attributes to cards for filtering
  document.querySelectorAll('.tool-card').forEach(card => {
    const section = card.closest('section');
    if (section) card.dataset.cat = section.dataset.cat;
    const typeBadge = card.querySelector('.badge-green, .badge-blue');
    if (typeBadge) card.dataset.type = typeBadge.classList.contains('badge-green') ? 'opensource' : 'comercial';
    // Certs from the card's parent section
    const certElements = section?.querySelectorAll('[data-certs]');
  });

  // Keyboard shortcut
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault(); document.getElementById('cat-select')?.focus();
    }
  });

  // Init
  updateUI();
</script>
