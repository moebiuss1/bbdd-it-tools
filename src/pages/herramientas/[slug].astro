---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { getCategories, getFamilies, getToolCategories, computeToolScore, scoreBreakdown as buildScoreBreakdown, toToolEntry } from "@lib/tools";
import InfraDiagram from "@components/InfraDiagram.astro";
import { getPlacement } from "@data/infrastructure";
export async function getStaticPaths() { return (await getCollection("tools")).map(t => ({ params: { slug: t.id.replace(/\.md$/,"") } })); }
const base = import.meta.env.BASE_URL;
const rawTools = await getCollection("tools");
const tools = rawTools.map(toToolEntry);
const categories = await getCategories();
const tool = tools.find(t => t.slug === Astro.params.slug);
if (!tool) return Astro.rewrite("/404");
const { data } = tool;

// El cuerpo se renderiza con el pipeline de Astro (markdown → HTML saneado).
// Antes se inyectaba el markdown crudo con `set:html`: los títulos y las listas
// salían como texto plano con almohadillas y guiones, y cualquier etiqueta HTML
// escrita en el .md se ejecutaba tal cual.
const rawEntry = rawTools.find(t => t.id.replace(/\.md$/, "") === tool.slug)!;
const { Content } = await render(rawEntry);
const families = await getFamilies();
const cats = categories.filter(c => getToolCategories(data).includes(c.id)); const cat = cats[0];
const family = cat ? families.find((f: any) => f.id === cat.family) : null;
const typeLabel = data.type === 'opensource' ? 'Open Source' : 'Comercial';
const costLabel = (data.cost_model && ({gratis:'Gratuito',freemium:'Freemium',suscripción:'Suscripción','licencia-perpetua':'Licencia perpetua','pago-por-uso':'Pago por uso','presupuesto-personalizado':'Presupuesto personalizado'} as any)[data.cost_model]) ?? '';
const sizeLabels: any = {pequeña:'Pequeña empresa',mediana:'Mediana empresa',grande:'Gran empresa'};

// Posición en la infraestructura: una entrada por categoría de la herramienta,
// deduplicando las que comparten explicación (categorías hermanas con el mismo
// emplazamiento, p. ej. varias variantes de backup).
const seenPlacements = new Set<string>();
const placementItems = cats
  .map(c => ({ category: c.name, placement: getPlacement(c.id, c.family) }))
  .filter((p): p is { category: string; placement: NonNullable<ReturnType<typeof getPlacement>> } => p.placement !== null)
  .filter(p => {
    const key = p.placement.rationale;
    if (seenPlacements.has(key)) return false;
    seenPlacements.add(key);
    return true;
  })
  .map(p => ({ category: p.category, nodes: p.placement.nodes, rationale: p.placement.rationale }));

// El diagrama marca todas las capas que toca la herramienta, pero solo se
// explican las tres primeras aportaciones distintas: una suite de backup con
// seis categorías hermanas encadenaría seis párrafos casi idénticos.
const highlightNodes = [...new Set(placementItems.flatMap(p => p.nodes))];
// Se conserva el orden original —la categoría principal primero— y solo pasan
// las que aportan alguna capa todavía no explicada.
const seenNodes = new Set<string>();
const shownPlacements = placementItems
  .filter(p => {
    const novel = p.nodes.some(n => !seenNodes.has(n));
    for (const n of p.nodes) seenNodes.add(n);
    return novel;
  })
  .slice(0, 3);
const omittedPlacements = placementItems.length - shownPlacements.length;

// Fuentes: enlace directo a la página citada, con el emisor identificado. Antes
// solo se mostraba el hostname, que no dice si detrás hay un cuadrante de
// Gartner, un laboratorio de test o una nota del propio fabricante.
const KNOWN_SOURCES: Record<string, { name: string; kind: string }> = {
  "gartner.com": { name: "Gartner", kind: "Análisis de mercado" },
  "forrester.com": { name: "Forrester", kind: "Análisis de mercado" },
  "idc.com": { name: "IDC", kind: "Análisis de mercado" },
  "av-comparatives.org": { name: "AV-Comparatives", kind: "Laboratorio independiente" },
  "av-test.org": { name: "AV-TEST", kind: "Laboratorio independiente" },
  "mitre.org": { name: "MITRE", kind: "Evaluación independiente" },
  "attackevals.mitre-engenuity.org": { name: "MITRE Engenuity", kind: "Evaluación independiente" },
  "github.com": { name: "GitHub", kind: "Repositorio de código" },
  "itsm.tools": { name: "ITSM.tools", kind: "Prensa especializada" },
  "owasp.org": { name: "OWASP", kind: "Comunidad de referencia" },
  "nist.gov": { name: "NIST", kind: "Organismo público" },
  "enisa.europa.eu": { name: "ENISA", kind: "Organismo público" },
  "ccn-cert.cni.es": { name: "CCN-CERT", kind: "Organismo público" },
  "peerspot.com": { name: "PeerSpot", kind: "Opiniones de usuarios" },
  "g2.com": { name: "G2", kind: "Opiniones de usuarios" },
};

const vendorHost = (() => { try { return new URL(data.website).hostname.replace(/^www\./, ""); } catch { return ""; } })();

const sourceLinks = (data.sources ?? []).flatMap((url: string) => {
  let parsed: URL;
  try { parsed = new URL(url); } catch { return []; }
  const host = parsed.hostname.replace(/^www\./, "");
  const known = KNOWN_SOURCES[host];
  const name = known?.name ?? host.split(".")[0].replace(/^./, c => c.toUpperCase());
  const kind = known?.kind ?? (host === vendorHost ? "Documentación del fabricante" : "Referencia del sector");
  const path = decodeURIComponent(parsed.pathname + parsed.search).replace(/\/$/, "");
  const full = host + path;
  // Un enlace a la portada de un portal no permite comprobar nada: se marca
  // como tal en lugar de presentarlo como si señalara la página concreta.
  const direct = path.split("/").filter(Boolean).length >= 2;
  return [{
    url,
    name: host === vendorHost && !known ? data.name : name,
    kind,
    direct,
    pretty: full.length > 72 ? `${full.slice(0, 71)}…` : full,
  }];
});

// Sistema de puntuación BBDD IT (0-100) — misma fórmula que en el directorio y los rankings (src/lib/tools.ts)
const totalScore = computeToolScore(data, tool.body);
const scoreBreakdown = buildScoreBreakdown(data, tool.body);
---

<BaseLayout title={data.name} description={data.description}>
  <Header active="herramientas" />

  <article class="py-10" id="contenido" tabindex="-1">
    <div class="container max-w-900">
      <nav class="mb-8 flex items-center gap-2" style="font-size:13px;color:#8e8e93" aria-label="Ruta de navegación">
        <a href={`${base}herramientas`} style="color:#0066cc">Directorio</a><span aria-hidden="true">/</span>
        {cat && <><a href={`${base}categorias/${cat.id}`} style="color:#0066cc">{cat.name}</a><span aria-hidden="true">/</span></>}
        <span class="truncate" style="color:#6e6e73" aria-current="page">{data.name}</span>
      </nav>

      <header class="detail-header">
        {data.logo && <div class="mb-4" style="width:56px;height:56px;border-radius:14px;background:#f5f5f7;display:flex;align-items:center;justify-content:center;overflow:hidden"><img src={`${base}${data.logo.replace(/^\//,'')}`} alt={data.name} width="35" height="35" style="object-fit:contain" /></div>}
        <div class="detail-badges">
          {family && <span class="badge badge-md" style="background:#f0fdfa;color:#0f766e">{family.icon} {family.name}</span>}
          <span class={`badge badge-md ${data.type==='opensource'?'badge-green':'badge-blue'}`}>{typeLabel}</span>
          {data.market_rank && cat && <span class="badge badge-amber badge-md">#{data.market_rank} en {cat.name}</span>}
          {costLabel && <span class="badge badge-gray badge-md">{costLabel}</span>}
        </div>
        <h1 class="detail-name">{data.name}</h1>
        <p class="detail-desc">{data.description}</p>
        {data.needs_review && <p style="margin-top:12px;font-size:13px;color:#d97706;display:flex;align-items:center;gap:6px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Ficha pendiente de revisión — algunos datos no han podido verificarse por completo todavía.
        </p>}
      </header>

      <div class="detail-grid">
        <div class="space-y-10">
          <section>
            <h2 class="section-title mb-4">Descripción</h2>
            <div class="prose"><Content /></div>
          </section>
          <section class="why-box">
            <h2>Por qué es un referente</h2>
            <p style="font-size:15px;color:#3a3a3c;line-height:1.6">{data.why_reference}</p>
          </section>
        </div>

        <aside class="space-y-5">
          <div class="sidebar-box space-y-4">
            <a href={data.website} target="_blank" rel="noopener" class="sidebar-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              {new URL(data.website).hostname}
            </a>
            {data.repo && <a href={data.repo} target="_blank" rel="noopener" class="sidebar-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg> Repositorio</a>}
            {data.company_size.length > 0 && <div class="sidebar-text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="15" y2="6"/><line x1="9" y1="10" x2="15" y2="10"/></svg>
              <span>{data.company_size.map((s:string) => sizeLabels[s]??s).join(" · ")}</span>
            </div>}
            {data.license && <div class="sidebar-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg><span>{data.license}</span></div>}
            {data.last_verified && <div class="sidebar-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>Verificado: {new Date(data.last_verified).toLocaleDateString("es-ES")}</span></div>}

            <!-- Estas fichas acaban citadas en informes y correos: copiar su
                 dirección es el gesto más repetido y no debería exigir ir a la
                 barra del navegador. -->
            <button type="button" class="copy-link" id="copy-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-copy-icon><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span data-copy-label aria-live="polite">Copiar enlace</span>
            </button>
          </div>

          {data.cost_details && <div class="sidebar-box"><h3 class="sidebar-box-title">Coste</h3><p style="font-size:14px;color:#6e6e73;line-height:1.5">{data.cost_details}</p></div>}

          <!-- Puntuación BBDD IT -->
          <div class="sidebar-box">
            <h3 class="sidebar-box-title">Puntuación BBDD IT</h3>
            <div class="flex items-center gap-3 mb-3">
              <div class="score-badge" style="
                --score-bg: {totalScore>=70?'#ecfdf5':totalScore>=40?'#fffbeb':'#fef2f2'};
                --score-color: {totalScore>=70?'#047857':totalScore>=40?'#b45309':'#b91c1c'};
                --score-pct: {totalScore}%;
              ">
                <!-- `pathLength="100"` hace que el trazo mida 100 unidades: sin
                     él el dasharray se medía contra la circunferencia real
                     (94,2 con r=15) y el aro marcaba un 6% de más. -->
                <svg width="52" height="52" viewBox="0 0 36 36" style="transform:rotate(-90deg)" role="img" aria-label={`Puntuación ${totalScore} sobre 100`}>
                  <circle cx="18" cy="18" r="15" fill="none" stroke="#f5f5f7" stroke-width="4"/>
                  <circle class="score-ring" cx="18" cy="18" r="15" fill="none" pathLength="100" stroke={totalScore>=70?'#047857':totalScore>=40?'#b45309':'#b91c1c'} stroke-width="4"
                    stroke-dasharray={`${totalScore} ${100-totalScore}`} stroke-linecap="round"/>
                </svg>
                <span class="tabular" style="position:absolute;font-size:15px;font-weight:700;color:#1d1d1f">{totalScore}</span>
              </div>
              <div>
                <div style="font-size:14px;font-weight:600;color:#1d1d1f">{totalScore>=70?'Excelente':totalScore>=50?'Notable':totalScore>=30?'Aceptable':'Pendiente'}</div>
                <div style="font-size:11px;color:#6e6e73">Puntuación sobre 100</div>
              </div>
            </div>
            <div class="space-y-1.5">
              {scoreBreakdown.map((s, i) => (
                <div class="flex items-center justify-between" style="font-size:11px">
                  <span style="color:#6e6e73;cursor:help" title={s.detail}>{s.label}</span>
                  <div style="display:flex;align-items:center;gap:6px">
                    <div style="width:40px;height:4px;background:#f5f5f7;border-radius:2px;overflow:hidden">
                      <div class="bar-grow" style={`height:100%;width:${(s.value/s.max)*100}%;background:#0071e3;border-radius:2px;animation-delay:${120 + i * 60}ms`}></div>
                    </div>
                    <span class="tabular" style="color:#1d1d1f;font-weight:500;min-width:20px;text-align:right;font-size:11px">{s.value}</span>
                  </div>
                </div>
              ))}
            </div>
            <details style="margin-top:8px">
              <summary style="font-size:11px;color:#6e6e73;cursor:pointer;list-style:none">¿Cómo se calcula?</summary>
              <div style="font-size:11px;color:#6e6e73;line-height:1.5;margin-top:4px;padding-left:8px;border-left:2px solid #e8e8ed">
                <p><strong>Posición de mercado (máx 30 pts):</strong> 30 puntos el puesto #1 de su categoría, restando 3,5 por cada puesto siguiente.</p>
                {data.type === 'opensource'
                  ? <p style="margin-top:4px"><strong>Transparencia (máx 25 pts):</strong> 10 por repositorio público, 7 por licencia identificada y hasta 8 por certificaciones. Un proyecto libre demuestra sus garantías con código auditable, no con certificados de producto.</p>
                  : <p style="margin-top:4px"><strong>Garantías auditadas (máx 25 pts):</strong> 5 puntos por cada certificación (ISO, SOC 2, ENS…) hasta 20, más 5 si el fabricante publica una página de verificación.</p>}
                <p style="margin-top:4px"><strong>Fuentes independientes (máx 20 pts):</strong> 5 puntos por cada fuente externa referenciada (Gartner, AV-Comparatives, etc.).</p>
                <p style="margin-top:4px"><strong>Actualización (máx 10 pts):</strong> 10 pts si se verificó hace menos de 30 días, 8 si menos de 90, 5 si menos de 180, 2 si más.</p>
                <p style="margin-top:4px"><strong>Ficha completa (máx 15 pts):</strong> descripción extendida, justificación, detalle de coste, logo y enlace de verificación. Una ficha marcada como pendiente de revisión puntúa 0 en este apartado.</p>
              </div>
            </details>
          </div>

          {data.certifications.length > 0 && <div class="sidebar-box">
            <h3 class="sidebar-box-title">Certificaciones</h3>
            <div class="sidebar-tags">{data.certifications.map((c:string) => <span class="badge badge-teal badge-sm">{c}</span>)}</div>
            {data.cert_url
              ? <a href={data.cert_url} target="_blank" rel="noopener" class="cert-link">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  Ver certificaciones del fabricante
                </a>
              : <p style="font-size:11px;color:#8e8e93;margin-top:10px;line-height:1.4">El fabricante no publica una página de certificaciones verificable. Solicítalas por su canal de soporte.</p>}
          </div>}

          <div class="sidebar-box"><h3 class="sidebar-box-title">Etiquetas</h3><div class="sidebar-tags">{data.tags.map((t:string) => <a href={`${base}herramientas?tag=${encodeURIComponent(t)}`} class="sidebar-tag">{t}</a>)}</div></div>

        </aside>
      </div>

      {sourceLinks.length > 0 && (
        <section class="sources-block">
          <h2 class="section-title mb-2">Fuentes</h2>
          <p class="sources-lead">
            Referencias externas donde aparece {data.name}. Cada enlace abre directamente la página citada,
            para que puedas comprobar el dato en su origen.
          </p>
          <ul class="sources-list">
            {sourceLinks.map(s => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-item">
                  <span class="source-name">{s.name}</span>
                  <span class="source-kind">{s.kind}{!s.direct && " · portal general, sin enlace directo"}</span>
                  <span class="source-url">{s.pretty}</span>
                </a>
              </li>
            ))}
          </ul>
          {data.cert_url && (
            <p class="sources-foot">
              Certificaciones verificables en
              <a href={data.cert_url} target="_blank" rel="noopener noreferrer">{new URL(data.cert_url).hostname.replace(/^www\./, "")}</a>.
            </p>
          )}
        </section>
      )}

      {shownPlacements.length > 0 && <InfraDiagram items={shownPlacements} highlight={highlightNodes} omitted={omittedPlacements} />}
    </div>
  </article>

  <Footer />
</BaseLayout>

<script>
  /* Copiar el enlace de la ficha.
     El botón confirma en sí mismo —icono de visto y "Enlace copiado"— durante
     un segundo y medio, y vuelve solo a su estado inicial. Sin avisos flotantes
     que tapen la ficha ni que haya que cerrar. */
  const btn = document.getElementById('copy-link') as HTMLButtonElement | null;

  if (btn) {
    const label = btn.querySelector('[data-copy-label]') as HTMLElement | null;
    const icon = btn.querySelector('[data-copy-icon]') as SVGElement | null;
    const copyIcon = icon?.innerHTML ?? '';
    const doneIcon = '<polyline points="20 6 9 17 4 12"/>';
    let timer: ReturnType<typeof setTimeout>;

    const feedback = (text: string, done: boolean) => {
      if (label) label.textContent = text;
      if (icon) icon.innerHTML = done ? doneIcon : copyIcon;
      btn.classList.toggle('is-done', done);
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (label) label.textContent = 'Copiar enlace';
        if (icon) icon.innerHTML = copyIcon;
        btn.classList.remove('is-done');
      }, 1800);
    };

    btn.addEventListener('click', async () => {
      const url = location.href;
      try {
        // `navigator.clipboard` solo existe en contextos seguros (https o
        // localhost); en el resto se recurre al método antiguo.
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(url);
        } else {
          const tmp = document.createElement('textarea');
          tmp.value = url;
          tmp.setAttribute('readonly', '');
          tmp.style.position = 'fixed';
          tmp.style.opacity = '0';
          document.body.appendChild(tmp);
          tmp.select();
          document.execCommand('copy');
          tmp.remove();
        }
        feedback('Enlace copiado', true);
      } catch {
        // Si el navegador deniega el portapapeles, decirlo: fingir que se ha
        // copiado deja al usuario pegando lo que tuviera antes.
        feedback('No se pudo copiar', false);
      }
    });
  }
</script>
