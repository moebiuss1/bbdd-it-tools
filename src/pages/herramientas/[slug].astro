---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, toToolEntry } from "@lib/tools";
export async function getStaticPaths() { return (await getCollection("tools")).map(t => ({ params: { slug: t.id.replace(/\.md$/,"") } })); }
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();
const tool = tools.find(t => t.slug === Astro.params.slug);
if (!tool) return Astro.rewrite("/404");
const { data } = tool;
const cat = categories.find(c => c.id === data.category);
const typeLabel = data.type === 'opensource' ? 'Open Source' : 'Comercial';
const costLabel = (data.cost_model && ({gratis:'Gratuito',freemium:'Freemium',suscripción:'Suscripción','licencia-perpetua':'Licencia perpetua','pago-por-uso':'Pago por uso','presupuesto-personalizado':'Presupuesto personalizado'} as any)[data.cost_model]) ?? '';
const sizeLabels: any = {pequeña:'Pequeña empresa',mediana:'Mediana empresa',grande:'Gran empresa'};
const tierColors: any = {Líder:'tier-lider',Visionario:'tier-visionario',Retador:'tier-retador',Nicho:'tier-nicho'};

// Sistema de puntuación BBDD IT (0-100)
const rankScore = data.market_rank ? Math.max(0, 40 - ((data.market_rank - 1) * 5)) : 10; // #1=40pts, #3=30pts, #5=20pts, #8+=5pts
const certScore = Math.min((data.certifications?.length ?? 0) * 6, 30); // Hasta 30pts por certificaciones (5 certs = 30)
const sourcesScore = Math.min((data.sources?.length ?? 0) * 5, 20); // Hasta 20pts por fuentes
const freshnessScore = data.last_verified ? (() => { const days = (Date.now() - new Date(data.last_verified).getTime()) / 86400000; return days < 30 ? 10 : days < 90 ? 7 : days < 180 ? 5 : 3; })() : 0;
const totalScore = Math.min(100, rankScore + certScore + sourcesScore + freshnessScore);

const scoreBreakdown = [
  { label: 'Ranking de mercado', value: rankScore, detail: data.market_rank ? `Posición #${data.market_rank} en su categoría` : 'Sin ranking asignado' },
  { label: 'Certificaciones', value: certScore, detail: `${data.certifications?.length ?? 0} certificaciones verificadas` },
  { label: 'Fuentes', value: sourcesScore, detail: `${data.sources?.length ?? 0} fuentes referenciadas` },
  { label: 'Actualización', value: freshnessScore, detail: data.last_verified ? `Verificado el ${new Date(data.last_verified).toLocaleDateString('es-ES')}` : 'Sin fecha de verificación' },
];
---

<BaseLayout title={data.name} description={data.description}>
  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2">
        <a href={`${base}herramientas`} class="nav-link">Directorio</a>
        <a href={`${base}ranking`} class="nav-link">Rankings</a>
        <a href={`${base}about`} class="nav-link">Acerca de</a>
      </div>
    </nav>
  </header>

  <article class="py-10">
    <div class="container max-w-900">
      <nav class="mb-8 flex items-center gap-2" style="font-size:13px;color:#aeaeb2">
        <a href={`${base}herramientas`} style="color:#0071e3">Directorio</a><span>/</span>
        {cat && <><a href={`${base}categorias/${cat.id}`} style="color:#0071e3">{cat.name}</a><span>/</span></>}
        <span class="truncate" style="color:#86868b">{data.name}</span>
      </nav>

      <header class="detail-header">
        <div class="detail-badges">
          <span class={`badge badge-md ${data.type==='opensource'?'badge-green':'badge-blue'}`}>{typeLabel}</span>
          {data.market_rank && cat && <span class="badge badge-amber badge-md">#{data.market_rank} en {cat.name}</span>}
          {costLabel && <span class="badge badge-gray badge-md">{costLabel}</span>}
        </div>
        <h1 class="detail-name">{data.name}</h1>
        <p class="detail-desc">{data.description}</p>
      </header>

      <div class="detail-grid">
        <div class="space-y-10">
          <section>
            <h2 class="section-title mb-4">Descripción</h2>
            <div class="prose" set:html={tool.body || ''} />
          </section>
          <section class="why-box">
            <h2>Por qué es un referente</h2>
            <p style="font-size:15px;color:#86868b;line-height:1.6">{data.why_reference}</p>
          </section>
        </div>

        <aside class="space-y-5">
          <div class="sidebar-box space-y-4">
            <a href={data.website} target="_blank" rel="noopener" class="sidebar-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              {new URL(data.website).hostname}
            </a>
            {data.repo && <a href={data.repo} target="_blank" rel="noopener" class="sidebar-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg> Repositorio</a>}
            {data.company_size.length > 0 && <div class="sidebar-text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="15" y2="6"/><line x1="9" y1="10" x2="15" y2="10"/></svg>
              <span>{data.company_size.map((s:string) => sizeLabels[s]??s).join(" · ")}</span>
            </div>}
            {data.license && <div class="sidebar-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg><span>{data.license}</span></div>}
            {data.last_verified && <div class="sidebar-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-top:2px;flex-shrink:0"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><span>Verificado: {new Date(data.last_verified).toLocaleDateString("es-ES")}</span></div>}
          </div>

          {data.cost_details && <div class="sidebar-box"><h3 class="sidebar-box-title">Coste</h3><p style="font-size:14px;color:#6e6e73;line-height:1.5">{data.cost_details}</p></div>}

          <!-- Puntuación BBDD IT -->
          <div class="sidebar-box">
            <h3 class="sidebar-box-title">Puntuación BBDD IT</h3>
            <div class="flex items-center gap-3 mb-3">
              <div style="width:48px;height:48px;border-radius:12px;background:{totalScore>=70?'#ecfdf5':totalScore>=40?'#fffbeb':'#fef2f2'};display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:{totalScore>=70?'#059669':totalScore>=40?'#d97706':'#dc2626'}">{totalScore}</div>
              <div>
                <div style="font-size:14px;font-weight:600;color:#1d1d1f">/100</div>
                <div style="font-size:11px;color:#6e6e73">{totalScore>=70?'Excelente':totalScore>=50?'Notable':totalScore>=30?'Aceptable':'Pendiente'}</div>
              </div>
            </div>
            <div class="space-y-1.5">
              {scoreBreakdown.map(s => (
                <div class="flex items-center justify-between" style="font-size:11px" title={s.detail}>
                  <span style="color:#6e6e73">{s.label}</span>
                  <span style="color:#1d1d1f;font-weight:500;min-width:24px;text-align:right">{s.value}</span>
                </div>
              ))}
            </div>
            <p style="font-size:11px;color:#8e8e93;margin-top:8px;line-height:1.4">La puntuación combina: posición en ranking (máx 40 pts), certificaciones verificadas (máx 30 pts), fuentes referenciadas (máx 20 pts) y frescura de la verificación (máx 10 pts).</p>
          </div>

          {data.certifications.length > 0 && <div class="sidebar-box"><h3 class="sidebar-box-title">Certificaciones</h3><div class="sidebar-tags">{data.certifications.map((c:string) => <span class="badge badge-teal badge-sm">{c}</span>)}</div></div>}

          <div class="sidebar-box"><h3 class="sidebar-box-title">Etiquetas</h3><div class="sidebar-tags">{data.tags.map((t:string) => <a href={`${base}herramientas?tag=${encodeURIComponent(t)}`} class="sidebar-tag">{t}</a>)}</div></div>

          {data.sources.length > 0 && <div class="sidebar-box"><h3 class="sidebar-box-title">Fuentes</h3><div class="sidebar-sources">{data.sources.map((s:string) => <div class="sidebar-source"><a href={s} target="_blank" rel="noopener" class="sidebar-link" style="font-size:13px">{new URL(s).hostname}</a></div>)}</div></div>}
        </aside>
      </div>
    </div>
  </article>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>
