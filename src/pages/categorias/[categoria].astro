---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, toToolEntry } from "@lib/tools";
export async function getStaticPaths() { return (await getCategories()).map(c => ({ params: { categoria: c.id } })); }
const base = import.meta.env.BASE_URL;
const categories = await getCategories();
const cat = categories.find(c => c.id === Astro.params.categoria); if (!cat) return Astro.rewrite("/404");
const tools = (await getCollection("tools")).map(toToolEntry);
const catTools = tools.filter(t => t.data.category === Astro.params.categoria).sort((a,b) => (a.data.market_rank??999)-(b.data.market_rank??999));
---

<BaseLayout title={cat.name} description={cat.description}>
  <header class="sticky top-0 z-40 header"><nav class="container header-inner"><a href={base} class="brand">BBDD IT</a><div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}about`} class="nav-link">Acerca de</a></div></nav></header>

  <section class="py-10"><div class="container max-w-900">
    <nav class="mb-8 flex items-center gap-2" style="font-size:13px;color:#aeaeb2"><a href={`${base}herramientas`} style="color:#0071e3">Directorio</a><span>/</span><span style="color:#86868b">{cat.name}</span></nav>
    <h1 class="section-title" style="font-size:28px">{cat.name}</h1><p class="section-desc">{cat.description}</p>
    {catTools.length===0 ? <div class="text-center py-16"><p class="section-desc">Próximamente — herramientas en esta categoría.</p></div> :
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 mt-8">
      {catTools.map(t => <a href={`${base}herramientas/${t.slug}`} class="card tool-card group"><div class="tool-avatar">{t.data.name.charAt(0)}</div><div class="min-w-0 flex-1"><h3 class="tool-name" style="color:#1d1d1f">{t.data.name}</h3><p class="tool-desc">{t.data.description}</p></div></a>)}
    </div>}
  </div></section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>
