---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getRankings, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();
const rankings = await getRankings();
const tierColors: any = {Líder:'tier-lider',Visionario:'tier-visionario',Retador:'tier-retador',Nicho:'tier-nicho'};
---

<BaseLayout title="Rankings">
  <header class="sticky top-0 z-40 header"><nav class="container header-inner"><a href={base} class="brand">BBDD IT</a><div class="flex items-center gap-2"><a href={`${base}herramientas`} class="nav-link">Directorio</a><a href={`${base}ranking`} class="nav-link">Rankings</a><a href={`${base}about`} class="nav-link">Acerca de</a></div></nav></header>

  <section class="py-10">
    <div class="container max-w-900">
      <h1 class="section-title" style="font-size:28px">Rankings</h1>
      <p class="section-desc" style="max-width:600px">Las mejores herramientas por categoría según consenso de fuentes referentes.</p>

      {Object.keys(rankings).length===0 ? <div class="text-center py-16"><p class="section-desc">Los rankings se generarán en la primera ejecución semanal.</p></div> :
      <div class="space-y-20 mt-10">
        {Object.entries(rankings).map(([catId, entries]: [string, any[]]) => {
          const c = categories.find(x => x.id===catId); if (!c) return null;
          return <section><h2 class="section-title mb-4">{c.name} <span style="color:#aeaeb2;font-weight:400">{entries.length}</span></h2>
            <div class="card" style="overflow:hidden">
              {entries.map((e:any,i:number) => { const t = tools.find(x=>x.slug===e.slug); if(!t) return null;
                return <a href={`${base}herramientas/${e.slug}`} class={`rank-row ${i===0?'rank-row-first':''}`}>
                  <div class="rank-num">{e.rank}</div><div class="rank-body"><h3 class="rank-name">{t.data.name}</h3><p class="rank-desc">{t.data.description}</p></div>
                  <div class="text-right" style="flex-shrink:0"><span class={`tier ${tierColors[e.tier]??'tier-nicho'}`}>{e.tier}</span><div class="tier-score">{e.score} pts</div></div>
                </a>;
              })}
            </div>
          </section>;
        })}
      </div>}
    </div>
  </section>

  <footer class="footer"><div class="container footer-grid"><div><p class="footer-brand">BBDD IT Tools</p><p class="footer-desc">Directorio actualizado cada lunes</p></div><div class="footer-links"><a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a><a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a><a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a></div></div></footer>
</BaseLayout>
