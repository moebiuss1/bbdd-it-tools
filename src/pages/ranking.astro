---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getRankings, toToolEntry } from "@lib/tools";
import ToolLogo from "@components/tools/ToolLogo.tsx";
import type { RankingEntry } from "@tipos/tool";

const rawTools = await getCollection("tools");
const tools = rawTools.map(toToolEntry);
const categories = await getCategories();
const rankings = await getRankings();
---

<BaseLayout
  title="Rankings"
  description="Rankings de las mejores herramientas IT por categoría, basados en consenso de mercado."
>
  <section class="py-12">
    <div class="container-app">
      <h1 class="mb-2 text-3xl font-bold text-[#1d1d1f]">Rankings</h1>
      <p class="mb-8 text-[#6e6e73]">
        Las mejores herramientas por categoría, según el consenso de fuentes referentes del mercado.
      </p>

      {
        Object.keys(rankings).length === 0 ? (
          <div class="rounded-2xl border border-[#e5e5ea] bg-[#f5f5f7] p-12 text-center">
            <p class="text-[#6e6e73]">Los rankings se generarán tras la primera ejecución del pipeline de actualización semanal.</p>
          </div>
        ) : (
          <div class="space-y-12">
            {Object.entries(rankings).map(([categoryId, entries]: [string, RankingEntry[]]) => {
              const cat = categories.find((c) => c.id === categoryId);
              return (
                <section id={categoryId}>
                  <div class="mb-4 flex items-center gap-3">
                    <h2 class="text-xl font-semibold text-[#1d1d1f]">{cat?.name ?? categoryId}</h2>
                    <span class="rounded-full bg-[#f5f5f7] px-2 py-0.5 text-xs text-[#aeaeb2]">
                      {entries.length} herramienta{entries.length !== 1 ? "s" : ""}
                    </span>
                  </div>

                  <div class="overflow-hidden rounded-2xl border border-[#e5e5ea]">
                    {entries.map((entry: RankingEntry, idx: number) => {
                      const tool = tools.find((t) => t.slug === entry.slug);
                      if (!tool) return null;
                      return (
                        <a
                          href={`/herramientas/${entry.slug}`}
                          class={`flex items-center gap-4 border-b border-[#e5e5ea] p-4 no-underline transition-colors hover:bg-[#f5f5f7] last:border-b-0 ${idx === 0 ? "bg-amber-50/50" : ""}`}
                        >
                          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f5f5f7] text-sm font-bold text-[#1d1d1f]">
                            {entry.rank}
                          </div>
                          <div class="shrink-0">
                            <ToolLogo name={tool.data.name} logo={tool.data.logo} size="sm" client:load />
                          </div>
                          <div class="min-w-0 flex-1">
                            <h3 class="font-medium text-[#1d1d1f]">{tool.data.name}</h3>
                            <p class="truncate text-xs text-[#aeaeb2]">{tool.data.description}</p>
                          </div>
                          <div class="shrink-0 text-right">
                            <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${
                              entry.tier === "Líder" ? "bg-amber-100 text-amber-700"
                              : entry.tier === "Visionario" ? "bg-blue-100 text-blue-700"
                              : entry.tier === "Retador" ? "bg-green-100 text-green-700"
                              : "bg-gray-100 text-gray-600"
                            }`}>
                              {entry.tier}
                            </span>
                            <div class="mt-1 text-[10px] text-[#aeaeb2]">Puntuación: {entry.score}</div>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </section>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
