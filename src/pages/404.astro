---
import BaseLayout from "@layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="No encontrada">
  <section class="flex flex-1 items-center justify-center py-24">
    <div class="text-center">
      <p class="text-[14px] font-medium uppercase tracking-wider text-[var(--color-text-tertiary)]">Error 404</p>
      <h1 class="mt-3 text-[2rem] font-bold tracking-tight text-[var(--color-text-primary)]">Página no encontrada</h1>
      <p class="mt-2 text-[15px] text-[var(--color-text-secondary)]">La página que buscas no existe o ha sido movida.</p>
      <a href={base} class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-5 py-2.5 text-[14px] font-medium text-white no-underline hover:bg-[var(--color-accent-hover)] transition-colors">Ir al inicio</a>
    </div>
  </section>
</BaseLayout>
