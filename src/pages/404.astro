---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe en BBDD IT Tools."
>
  <section class="flex flex-1 items-center justify-center py-20">
    <div class="text-center">
      <h1 class="mb-4 text-6xl font-bold text-[#d2d2d7]">404</h1>
      <p class="mb-2 text-xl font-semibold text-[#1d1d1f]">Página no encontrada</p>
      <p class="mb-8 text-[#6e6e73]">
        La página que buscas no existe o ha sido movida.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-[#0071e3] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#0077ed] no-underline"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
