---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, getTagCounts, toToolEntry, sortTools } from "@lib/tools";
import ToolCard from "@components/tools/ToolCard.tsx";
import { ArrowRight } from "lucide-react";

const rawTools = await getCollection("tools");
const tools = rawTools.map(toToolEntry);
const categories = await getCategories();
const tagCounts = getTagCounts(tools);

// Top tags (más frecuentes)
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15);

// Herramientas destacadas (top ranking)
const destacadas = tools
  .filter((t) => t.data.market_rank && t.data.market_rank <= 3)
  .sort((a, b) => (a.data.market_rank ?? 999) - (b.data.market_rank ?? 999))
  .slice(0, 6);
---

<BaseLayout
  title="Directorio de Herramientas IT"
  description="Repositorio vivo de herramientas para seguridad, cumplimiento y auditoría IT. Actualizado semanalmente mediante búsqueda automatizada en fuentes referentes."
>
  <!-- Hero -->
  <section class="bg-[#f5f5f7] py-20">
    <div class="container-app text-center">
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-[#1d1d1f] sm:text-5xl">
        Directorio de herramientas IT
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-[#6e6e73] leading-relaxed">
        Repositorio vivo para profesionales de seguridad, consultores y auditores.
        Actualizado semanalmente desde fuentes como Gartner, ITSM.tools y repositorios
        referentes.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/herramientas"
          class="inline-flex items-center gap-2 rounded-full bg-[#0071e3] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#0077ed] no-underline"
        >
          Explorar herramientas
          <ArrowRight size={16} />
        </a>
        <a
          href="/ranking"
          class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-[#1d1d1f] border border-[#d2d2d7] transition-colors hover:bg-[#f5f5f7] no-underline"
        >
          Ver rankings
        </a>
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section id="categorias" class="py-16">
    <div class="container-app">
      <h2 class="mb-2 text-2xl font-semibold text-[#1d1d1f]">Categorías</h2>
      <p class="mb-8 text-[#6e6e73]">
        {categories.length} categorías de herramientas de seguridad y cumplimiento
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => {
          const count = tools.filter((t) => t.data.category === cat.id).length;
          return (
            <a
              href={`/categorias/${cat.id}`}
              class="card flex items-center gap-4 px-5 py-4 no-underline"
            >
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#f5f5f7] text-lg">
                {cat.icon === "shield" && "🛡️"}
                {cat.icon === "crosshair" && "🎯"}
                {cat.icon === "wall" && "🧱"}
                {cat.icon === "activity" && "📊"}
                {cat.icon === "zap" && "⚡"}
                {cat.icon === "user-check" && "👤"}
                {cat.icon === "key" && "🔑"}
                {cat.icon === "bar-chart" && "📈"}
                {cat.icon === "monitor" && "🖥️"}
                {cat.icon === "settings" && "⚙️"}
                {cat.icon === "eye-off" && "👁️‍🗨️"}
                {cat.icon === "smartphone" && "📱"}
                {cat.icon === "award" && "🏅"}
                {cat.icon === "alert-triangle" && "⚠️"}
                {cat.icon === "shield-off" && "🛡️"}
              </span>
              <div>
                <h3 class="font-medium text-[#1d1d1f]">{cat.name}</h3>
                <p class="text-xs text-[#aeaeb2]">
                  {count} herramienta{count !== 1 ? "s" : ""}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Herramientas destacadas -->
  {
    destacadas.length > 0 && (
      <section class="bg-[#f5f5f7] py-16">
        <div class="container-app">
          <div class="mb-8 flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-semibold text-[#1d1d1f]">Destacadas</h2>
              <p class="text-[#6e6e73]">Herramientas líderes en sus categorías</p>
            </div>
            <a
              href="/herramientas"
              class="text-sm font-medium text-[#0071e3] hover:underline"
            >
              Ver todas →
            </a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {destacadas.map((tool) => (
              <ToolCard tool={tool} client:load />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Etiquetas populares -->
  <section class="py-16">
    <div class="container-app">
      <h2 class="mb-2 text-2xl font-semibold text-[#1d1d1f]">Temas</h2>
      <p class="mb-6 text-[#6e6e73]">Explora por etiqueta</p>
      <div class="flex flex-wrap gap-2">
        {topTags.map(([tag, count]) => (
          <a
            href={`/herramientas?tag=${encodeURIComponent(tag)}`}
            class="inline-flex items-center gap-2 rounded-full border border-[#d2d2d7] bg-white px-4 py-2 text-sm text-[#1d1d1f] transition-colors hover:border-[#0071e3] hover:text-[#0071e3] no-underline"
          >
            {tag}
            <span class="rounded-full bg-[#f5f5f7] px-1.5 py-0.5 text-xs text-[#aeaeb2]">
              {count}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Info -->
  <section class="border-t border-[#e5e5ea] bg-[#f5f5f7] py-12">
    <div class="container-app text-center">
      <p class="text-sm text-[#6e6e73]">
        <strong>{tools.length}</strong> herramientas indexadas ·
        Actualizado semanalmente · Datos de Gartner, ITSM.tools, GitHub y webs
        especializadas
      </p>
    </div>
  </section>
</BaseLayout>
