---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategories, toToolEntry } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();

// Agrupar herramientas por categoría y ordenar por ranking
const catTools = categories.map(cat => ({
  ...cat,
  tools: tools.filter(t => t.data.category === cat.id).sort((a,b) => (a.data.market_rank??999)-(b.data.market_rank??999)).slice(0, 5)
})).filter(c => c.tools.length > 0);
---

<BaseLayout title="Directorio de Herramientas IT">

  <header class="sticky top-0 z-40 header">
    <nav class="container header-inner">
      <a href={base} class="brand">BBDD IT</a>
      <div class="flex items-center gap-2">
        <a href={`${base}herramientas`} class="nav-link">Directorio</a>
        <a href={`${base}ranking`} class="nav-link">Rankings</a>
        <a href={`${base}about`} class="nav-link">Acerca de</a>
      </div>
      <div class="flex-1"></div>
      <form action={`${base}herramientas`} method="get" style="max-width:220px;width:100%">
        <input type="search" name="q" placeholder="Buscar" class="search-input">
      </form>
    </nav>
  </header>

  <section class="hero">
    <div class="container text-center max-w-800 mx-auto">
      <span class="badge badge-outline badge-md" style="text-transform:uppercase;letter-spacing:.05em">Actualizado el 10 de agosto</span>
      <h1 class="hero-title mt-6">Herramientas IT. Sin humo.</h1>
      <p class="hero-subtitle mx-auto">Un directorio honesto y actualizado de software de seguridad, cumplimiento y auditoría. {tools.length} herramientas en {categories.length} categorías, rankeadas por consenso del mercado.</p>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a href={`${base}herramientas`} class="btn btn-primary">Ver directorio <span style="font-size:18px;line-height:1">→</span></a>
        <a href={`${base}ranking`} class="btn btn-outline">Ver rankings</a>
      </div>
      <div class="hero-stats mt-10">
        <div><span class="hero-stat-num">{tools.length}</span> herramientas</div>
        <div class="hero-divider hidden sm:block"></div>
        <div><span class="hero-stat-num">{categories.length}</span> categorías</div>
        <div class="hero-divider hidden sm:block"></div>
        <div><span class="hero-stat-num">Cada lunes</span> actualización</div>
      </div>
    </div>
  </section>

  <!-- Herramientas agrupadas por categoría -->
  {catTools.map((cat, ci) => (
    <section class={ci % 2 === 0 ? 'section' : 'section-alt'}>
      <div class="container">
        <div class="section-header">
          <div>
            <h2 class="section-title">{cat.name}</h2>
            <p class="section-desc">{cat.description}</p>
          </div>
          <a href={`${base}categorias/${cat.id}`} class="hidden sm:inline" style="font-size:14px;font-weight:500;color:#0071e3">Ver las {cat.tools.length} →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {cat.tools.slice(0, 3).map(tool => (
            <a href={`${base}herramientas/${tool.slug}`} class="card tool-card group">
              <div class="tool-avatar">
                {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt={tool.data.name} width="40" height="40" style="border-radius:10px;object-fit:contain" loading="lazy" /> : tool.data.name.charAt(0)}
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>
                  {tool.data.market_rank && tool.data.market_rank <= 3 && <span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}
                </div>
                <p class="tool-desc">{tool.data.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  <span class={`badge badge-sm ${tool.data.type==='opensource'?'badge-green':'badge-blue'}`}>{tool.data.type==='opensource'?'Open Source':'Comercial'}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <footer class="footer">
    <div class="container footer-grid">
      <div>
        <p class="footer-brand">BBDD IT Tools</p>
        <p class="footer-desc">Directorio actualizado cada lunes · {tools.length} herramientas en {categories.length} categorías</p>
      </div>
      <div class="footer-links">
        <a href={`${base}herramientas`} class="nav-link" style="font-size:12px">Directorio</a>
        <a href={`${base}ranking`} class="nav-link" style="font-size:12px">Rankings</a>
        <a href={`${base}about`} class="nav-link" style="font-size:12px">Acerca de</a>
      </div>
    </div>
  </footer>
</BaseLayout>
