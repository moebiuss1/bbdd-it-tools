---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { getCategories, getToolCategories, toToolEntry, categorySizes, hasMeaningfulRank, isNewTool } from "@lib/tools";
const base = import.meta.env.BASE_URL;
const tools = (await getCollection("tools")).map(toToolEntry);
const categories = await getCategories();
const sizes = categorySizes(tools);

const catTools = categories.map(cat => ({
  ...cat,
  tools: tools.filter(t => getToolCategories(t.data).includes(cat.id)).sort((a,b) => (a.data.market_rank??999)-(b.data.market_rank??999))
})).filter(c => c.tools.length > 0);

// Destacadas: primeros puestos, pero solo de categorías con competencia real.
// Sin ese filtro entraban aquí herramientas que son "#1" de una categoría que
// solo las contiene a ellas.
const destacadas = tools
  .filter(t => t.data.market_rank && t.data.market_rank <= 2 && hasMeaningfulRank(t.data, sizes))
  .sort((a,b) => (a.data.market_rank??999)-(b.data.market_rank??999))
  .slice(0, 6);

// Últimas incorporaciones — por fecha de alta (`first_added`), no por
// `last_verified`: el pipeline reverifica todo el catálogo cada lunes, así que
// ordenar por verificación presentaba las 182 fichas como recién llegadas.
const site = Astro.site?.toString() ?? "https://moebiuss1.github.io/";
const home = new URL(base, site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "BBDD IT Tools",
    url: home,
    inLanguage: "es-ES",
    description: `Directorio de ${tools.length} herramientas IT de seguridad, cumplimiento y auditoría, con fuentes verificables en cada ficha.`,
    // Deja que el buscador ofrezca la búsqueda del directorio desde su propio
    // resultado, en vez de obligar a entrar y volver a escribir.
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${new URL(`${base}herramientas`, site).toString()}?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "BBDD IT Tools",
    url: home,
    logo: new URL(`${base}icon-512.png`, site).toString(),
  },
];

const nuevas = tools
  .filter(t => t.data.first_added)
  .sort((a,b) => new Date(b.data.first_added!).getTime() - new Date(a.data.first_added!).getTime())
  .slice(0, 6);
---

<BaseLayout title="Directorio de Herramientas IT" jsonLd={jsonLd}>

  <Header active="home" search />

  <section class="hero" id="contenido" tabindex="-1">
    <div class="container text-center max-w-800 mx-auto">
      <h1 class="hero-title mt-6">Herramientas IT. Sin humo.</h1>
      <p class="hero-subtitle mx-auto">{tools.length} herramientas en {categories.length} categorías, rankeadas por consenso del mercado. Actualizado cada lunes.</p>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a href={`${base}herramientas`} class="btn btn-primary">Explorar directorio <span class="btn-arrow" style="font-size:18px;line-height:1">→</span></a>
        <a href={`${base}ranking`} class="btn btn-outline">Ver rankings</a>
      </div>
    </div>
  </section>

  <!-- Destacadas -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Destacadas</h2>
        <a href={`${base}herramientas?sort=rank`} class="hidden sm:inline" style="font-size:14px;font-weight:500;color:#0066cc">Ver todas →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {destacadas.map(tool => (
          <a href={`${base}herramientas/${tool.slug}`} class="card tool-card group">
            <div class="tool-avatar">
              {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt={tool.data.name} width="35" height="35" style="border-radius:10px;object-fit:contain" loading="lazy" /> : tool.data.name.charAt(0)}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>
                {tool.data.market_rank && tool.data.market_rank <= 3 && hasMeaningfulRank(tool.data, sizes) && <span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}
              </div>
              <p class="tool-desc">{tool.data.description}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <span class={`badge badge-sm ${tool.data.type==='opensource'?'badge-green':'badge-blue'}`}>{tool.data.type==='opensource'?'Open Source':'Comercial'}</span>
                <span class="badge badge-gray badge-sm">{categories.find(c=>c.id===getToolCategories(tool.data)[0])?.name??getToolCategories(tool.data)[0]??''}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Últimas incorporaciones -->
  {nuevas.length > 0 && <section class="section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Últimas incorporaciones</h2>
        <a href={`${base}novedades`} class="hidden sm:inline" style="font-size:14px;font-weight:500;color:#0066cc">Ver el historial →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {nuevas.map(tool => (
          <a href={`${base}herramientas/${tool.slug}`} class="card tool-card group">
            <div class="tool-avatar">
              {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt={tool.data.name} width="35" height="35" style="border-radius:10px;object-fit:contain" loading="lazy" /> : tool.data.name.charAt(0)}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>
                {/* "Nuevo" solo durante los primeros 30 días desde el alta (NEW_TOOL_DAYS) */}
                {isNewTool(tool.data) && <span class="badge badge-green badge-sm" title={`Añadida el ${new Date(tool.data.first_added!).toLocaleDateString('es-ES')}`}>Nuevo</span>}
              </div>
              <p class="tool-desc">{tool.data.description}</p>
              {tool.data.first_added && <p class="tool-date">En el directorio desde el {new Date(tool.data.first_added).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>}

  <!-- Categorías en acordeón -->
  <section class="section">
    <div class="container">
      <h2 class="section-title mb-8">Todas las categorías</h2>
      <div class="space-y-2">
        {catTools.map((cat, i) => (
          <details class="accordion-cat" open={i < 4}>
            <summary class="accordion-summary">
              <span class="accordion-title">{cat.name}</span>
              <span class="badge badge-gray badge-sm">{cat.tools.length}</span>
              <svg class="accordion-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8e8e93" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="accordion-body">
              <p class="section-desc" style="margin-bottom:16px">{cat.description}</p>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {cat.tools.slice(0, 3).map(tool => (
                  <a href={`${base}herramientas/${tool.slug}`} class="card tool-card group">
                    <div class="tool-avatar">
                      {tool.data.logo ? <img src={`${base}${tool.data.logo.replace(/^\//,'')}`} alt={tool.data.name} width="35" height="35" style="border-radius:10px;object-fit:contain" loading="lazy" /> : tool.data.name.charAt(0)}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <h3 class="tool-name" style="color:#1d1d1f">{tool.data.name}</h3>
                        {tool.data.market_rank && tool.data.market_rank <= 3 && hasMeaningfulRank(tool.data, sizes) && <span class="badge badge-amber badge-sm">#{tool.data.market_rank}</span>}
                      </div>
                      <p class="tool-desc">{tool.data.description}</p>
                    </div>
                  </a>
                ))}
              </div>
              {cat.tools.length > 3 && <a href={`${base}categorias/${cat.id}`} class="btn btn-outline mt-3" style="font-size:13px">Ver las {cat.tools.length} herramientas en {cat.name} →</a>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
/* Accordion */
.accordion-cat{border:1px solid #e8e8ed;border-radius:14px;overflow:hidden;transition:background .15s}
.accordion-cat[open]{background:#fafafa}
.accordion-summary{display:flex;align-items:center;gap:10px;padding:14px 18px;cursor:pointer;list-style:none;font-size:15px;font-weight:600;color:#1d1d1f;-webkit-user-select:none;user-select:none}
.accordion-summary::-webkit-details-marker{display:none}
.accordion-summary:hover{background:#f5f5f7}
.accordion-title{flex:1}
.accordion-chevron{flex-shrink:0;transition:transform .2s}
.accordion-cat[open] .accordion-chevron{transform:rotate(180deg)}
.accordion-body{padding:0 18px 20px}
.tool-date{margin-top:6px;font-size:11px;color:#6e6e73}
</style>

<script>
  import "../scripts/home";
</script>
